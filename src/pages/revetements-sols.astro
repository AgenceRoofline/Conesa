---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZonesIntervention from '../components/ZonesIntervention.astro';

const prestations = [
  {
    titre: "Sols PVC",
    desc: "Polyvalents et faciles d'entretien, les sols PVC s'adaptent à tous les espaces résidentiels et professionnels. Disponibles dans une grande variété de coloris et d'effets décoratifs, ils offrent un excellent rapport qualité-prix.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>`,
  },
  {
    titre: "Sols vinyles",
    desc: "Les sols vinyles combinent liberté décorative et résistance à l'usage quotidien. Ils imitent à la perfection le bois, le béton ou la pierre et constituent une solution idéale pour les rénovations intérieures modernes.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`,
  },
  {
    titre: "Moquettes",
    desc: "La moquette crée des espaces chaleureux et confortables tout en améliorant l'isolation acoustique des pièces. Idéale pour les chambres, les bureaux et les espaces de vie où le confort est une priorité.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
  {
    titre: "Parquets stratifiés",
    desc: "Le parquet stratifié apporte l'esthétique chaleureuse du bois naturel avec une facilité d'entretien et un prix accessible. Il s'intègre parfaitement dans les projets de rénovation contemporaine.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>`,
  },
];

const signes = [
  {
    titre: "Sol usé ou endommagé",
    desc: "Les rayures profondes, les zones creusées, les carreaux cassés ou les lames gondolées signalent un revêtement en fin de vie. Au-delà de l'aspect esthétique, un sol abîmé peut représenter un risque de chute et d'inconfort au quotidien.",
  },
  {
    titre: "Revêtement décollé ou gondolé",
    desc: "Un sol qui se soulève, se décolle ou présente des cloques révèle souvent un problème d'humidité ou une pose initiale défectueuse. Ces défauts s'aggravent avec le temps et nécessitent une intervention rapide pour éviter d'endommager le support.",
  },
  {
    titre: "Sol difficile à entretenir",
    desc: "Certains revêtements anciens deviennent poreux avec les années et absorbent taches et salissures malgré les efforts de nettoyage. Un nouveau sol adapté simplifie considérablement l'entretien au quotidien.",
  },
  {
    titre: "Décoration vieillissante",
    desc: "Un revêtement démodé ou dont les coloris ne correspondent plus à vos goûts peut nuire à l'ambiance générale d'une pièce. Le remplacement du sol est souvent la transformation la plus rapide pour moderniser un intérieur.",
  },
];

const avantages = [
  {
    titre: "Un résultat esthétique durable",
    desc: "Une pose réalisée dans les règles de l'art garantit un rendu impeccable et homogène, sans joints irréguliers ni déformations. Votre sol reste beau et fonctionnel pendant de nombreuses années.",
  },
  {
    titre: "Une pose soignée et conforme",
    desc: "La préparation du support est aussi importante que le revêtement lui-même. Nos équipes vérifient systématiquement l'état du sol existant, corrigent les irrégularités et posent dans le respect des normes en vigueur.",
  },
  {
    titre: "Une meilleure longévité",
    desc: "Un revêtement bien posé sur un support sain dure bien plus longtemps qu'un sol posé à la hâte. C'est un investissement rentable qui repousse les remplacements prématurés.",
  },
  {
    titre: "Un confort renforcé",
    desc: "Le bon revêtement améliore non seulement l'esthétique mais aussi le confort thermique et acoustique de vos espaces, selon les matériaux choisis et les contraintes de chaque pièce.",
  },
];

const etapes = [
  { num: "01", titre: "Analyse des besoins", desc: "Évaluation de l'utilisation des espaces, des contraintes techniques (humidité, passage, luminosité), de vos préférences esthétiques et de votre budget. Chaque projet est unique." },
  { num: "02", titre: "Conseils sur les matériaux", desc: "Présentation des solutions adaptées à votre projet : PVC, vinyle, moquette, parquet stratifié. Nous vous guidons pour faire le choix le plus pertinent selon votre usage et votre style." },
  { num: "03", titre: "Préparation des supports", desc: "Vérification et ragréage du sol existant pour corriger les irrégularités. Un support plan et sain est indispensable pour une pose durable et un résultat parfait." },
  { num: "04", titre: "Pose du revêtement", desc: "Pose soignée par nos équipes, avec respect des joints, découpes précises aux contours et finitions impeccables aux plinthes. Chaque détail compte pour un rendu professionnel." },
  { num: "05", titre: "Contrôle final", desc: "Vérification minutieuse de la qualité de pose, remise en état des abords et conseils d'entretien adaptés à votre nouveau revêtement. Le chantier vous est remis propre et conforme." },
];

const engagements = [
  "Plus de 55 ans d'expérience en rénovation intérieure",
  "Entreprise familiale et équipes locales dans le Tarn",
  "Certification RGE et Qualibat",
  "Devis gratuit, détaillé et sans engagement",
  "Accompagnement dans le choix des matériaux",
  "Interlocuteur unique de A à Z",
  "Qualité de finition garantie sur chaque chantier",
];

const villes = ["Albi", "Gaillac", "Castres", "Graulhet", "Lavaur", "Carmaux", "Mazamet", "Saint-Sulpice"];

const villesLinks: Record<string, string> = {
  "Albi": "/villes/albi",
  "Gaillac": "/villes/gaillac",
  "Castres": "/villes/castres",
  "Graulhet": "/villes/graulhet",
};

const faqs = [
  {
    q: "Quel revêtement de sol choisir pour une maison ?",
    a: "Le choix dépend avant tout de l'usage de chaque pièce. Pour les pièces humides, privilégiez le PVC ou le vinyle. Dans les pièces de vie, le parquet stratifié ou le vinyle apportent chaleur et esthétique. Pour les chambres, la moquette est une option confortable. Nos équipes vous conseillent lors d'un rendez-vous gratuit pour trouver la solution adaptée à chaque espace.",
  },
  {
    q: "Quelle est la différence entre PVC et vinyle ?",
    a: "Les sols PVC et vinyles sont souvent confondus car ils partagent des composants similaires. En pratique, les sols vinyles désignent généralement les versions haut de gamme avec un rendu plus réaliste (imitation bois, béton, pierre) et un meilleur confort de marche. Les sols PVC sont davantage orientés vers la résistance et l'économie. Dans les deux cas, l'entretien est simple et la durabilité est excellente.",
  },
  {
    q: "Le parquet stratifié résiste-t-il à l'usure ?",
    a: "Oui, à condition de choisir une classe d'usure adaptée à l'utilisation prévue. Pour les espaces de vie courants, une classe AC3 ou AC4 est généralement recommandée. Pour les zones très fréquentées, une classe AC5 offre une meilleure résistance. Le parquet stratifié n'apprécie pas l'humidité prolongée : il est déconseillé dans les salles de bains et les cuisines.",
  },
  {
    q: "La moquette est-elle encore tendance ?",
    a: "La moquette revient dans les projets de décoration contemporains, notamment dans les chambres et les bureaux. Les nouvelles générations de moquettes sont plus faciles à entretenir, resistantes aux taches et disponibles dans une large gamme de coloris et de textures. Elles offrent un confort acoustique et thermique que les sols durs ne peuvent pas égaler.",
  },
  {
    q: "Combien coûte un revêtement de sol ?",
    a: "Le prix varie selon la surface, le type de revêtement choisi et l'état du support existant. À titre indicatif, comptez entre 20 et 60 €/m² tout compris selon les matériaux. Un parquet stratifié milieu de gamme ou un vinyle qualitatif représentent un investissement raisonnable comparé à la durée de vie obtenue. Contactez-nous pour un devis gratuit et personnalisé.",
  },
  {
    q: "Combien de temps dure la pose ?",
    a: "Pour une pièce standard (20 à 30 m²), la pose prend généralement une journée, parfois deux si le support nécessite un ragréage important. Pour l'ensemble d'un appartement ou d'une maison, comptez 2 à 4 jours selon la surface et la complexité. Un planning précis vous est communiqué lors de l'établissement du devis.",
  },
  {
    q: "Quel est le revêtement le plus facile à entretenir ?",
    a: "Les sols PVC et vinyles sont les champions de la facilité d'entretien : imperméables, ils se nettoient à l'aspirateur et à la serpillière humide sans traitement particulier. Le parquet stratifié demande quelques précautions (éviter l'eau en excès) mais reste simple d'entretien. La moquette nécessite un aspirateur régulier et un nettoyage professionnel tous les 1 à 2 ans selon l'usage.",
  },
  {
    q: "Comment obtenir un devis ?",
    a: "Remplissez notre formulaire de contact, appelez-nous au 05 63 54 16 97 ou envoyez-nous un email. Un technicien Conesa se déplace gratuitement pour évaluer vos espaces, vous conseiller sur les matériaux et vous remettre un devis détaillé, sans engagement de votre part, sous 24 h.",
  },
];

const jsonLdService = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Revêtements de sols",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Conesa",
    "telephone": "+33563541697",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Albi",
      "postalCode": "81000",
      "addressCountry": "FR"
    }
  },
  "areaServed": { "@type": "AdministrativeArea", "name": "Tarn" },
  "description": "Pose et rénovation de revêtements de sols dans le Tarn. PVC, vinyle, moquette, parquet stratifié : des solutions adaptées à tous vos projets.",
  "url": "https://conesa-renovation.fr/revetements-sols"
});

const jsonLdBreadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://conesa-renovation.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Revêtements de sols", "item": "https://conesa-renovation.fr/revetements-sols" }
  ]
});

const jsonLdFaq = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
});
---

<BaseLayout
  title="Revêtements de sols dans le Tarn | PVC, Vinyle, Moquette, Stratifié | Conesa"
  description="Pose et rénovation de revêtements de sols dans le Tarn. PVC, vinyle, moquette, parquet stratifié : des solutions adaptées à tous vos projets."
>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdService} />
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdBreadcrumb} />
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdFaq} />

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-[#0A1E3D]" style="padding-top: 200px; padding-bottom: 96px;">
    <img
      src={encodeURI("/images/Page revetements sols/Hero revêtement de sols.png")}
      alt="Revêtements de sols dans le Tarn — Conesa"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      fetchpriority="high"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,30,61,0.92) 0%, rgba(30,75,140,0.78) 60%, rgba(10,30,61,0.72) 100%);"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="absolute top-0 left-0 w-1 h-full bg-[#E8650A] opacity-60"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Fil d'Ariane -->
      <nav class="flex items-center gap-2 text-white/50 text-sm mb-8" aria-label="Fil d'Ariane">
        <a href="/" class="hover:text-white transition-colors">Accueil</a>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white/80">Revêtements de sols</span>
      </nav>

      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 text-sm font-medium text-white mb-8">
          <span class="w-2 h-2 bg-[#E8650A] rounded-full"></span>
          Entreprise familiale dans le Tarn depuis 1969
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-[3rem] font-extrabold text-white leading-[1.1] mb-6" style="font-family:'Montserrat',sans-serif;">
          Pose et rénovation de<br>revêtements de sols
          <span class="text-[#E8650A]"> dans le Tarn</span>
        </h1>
        <p class="text-blue-100 text-lg leading-relaxed mb-10 max-w-xl">
          PVC, vinyle, moquette, parquet stratifié : Conesa vous accompagne dans le choix et la pose de revêtements de sols adaptés à votre habitation, vos espaces professionnels et votre style de vie.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#contact" class="inline-flex items-center justify-center gap-2 bg-[#E8650A] hover:bg-orange-700 text-white font-bold px-8 py-4 rounded-xl transition-all duration-200 hover:scale-105 shadow-lg shadow-orange-900/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Demander un devis gratuit
          </a>
          <a href="tel:0563541697" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-semibold px-8 py-4 rounded-xl transition-all duration-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            05 63 54 16 97
          </a>
        </div>
        <div class="flex items-center gap-4">
          <img src="/images/labels/Logo-RGE.png" alt="RGE Qualibat" class="h-11 w-auto bg-white rounded-lg p-1 shadow" loading="lazy" decoding="async" onerror="this.style.display='none'"/>
          <span class="text-blue-100 text-sm">Certifié RGE &amp; Qualibat — Devis gratuit sous 24 h</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       POURQUOI RÉNOVER SON SOL
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Pourquoi rénover ?</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 mb-6 leading-tight" style="font-family:'Montserrat',sans-serif;">
            Pourquoi rénover ou remplacer<br>un revêtement de sol ?
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Avec le temps, les revêtements de sols subissent une usure naturelle liée aux passages répétés, aux chocs, à l'humidité ou à l'évolution des tendances décoratives. Un sol dégradé ne se limite pas à un problème esthétique : il peut affecter le confort, la sécurité et la valeur de votre bien.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Le remplacement d'un revêtement peut transformer complètement l'ambiance d'un intérieur, améliorer son praticité et valoriser votre patrimoine immobilier.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              "Améliorer le confort et la qualité de vie au quotidien",
              "Moderniser l'apparence et l'ambiance d'une pièce",
              "Augmenter la résistance des surfaces très sollicitées",
              "Simplifier l'entretien et le nettoyage",
              "Valoriser le logement avant une vente ou une mise en location",
              "Adapter les espaces à de nouveaux usages",
            ].map(item => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full bg-[#E8650A] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <!-- Image -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl" style="min-height:340px;">
            <img
              src={encodeURI("/images/Page revetements sols/Revêtement de sol.png")}
              alt="Pose de revêtement de sol — Conesa, entreprise familiale dans le Tarn"
              class="w-full h-full object-cover object-center absolute inset-0"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,30,61,0.45) 0%, rgba(10,30,61,0.08) 45%, transparent 100%);"></div>
          </div>
          <!-- Encarts à cheval sur le bas de l'image -->
          <div class="relative z-10 -mt-9 flex items-center justify-center gap-3 flex-wrap px-6">
            {[
              { val: "55+", label: "ans d'expérience" },
              { val: "500+", label: "chantiers Tarn" },
            ].map(item => (
              <div class="bg-[#1E4B8C]/80 backdrop-blur-md border border-white/20 rounded-xl px-5 py-3 text-center shadow-xl min-w-[110px]">
                <p class="text-2xl font-extrabold text-white leading-none mb-1" style="font-family:'Montserrat',sans-serif;">{item.val}</p>
                <p class="text-blue-200 text-xs font-medium">{item.label}</p>
              </div>
            ))}
            <div class="bg-[#E8650A]/85 backdrop-blur-md border border-white/20 rounded-xl px-5 py-3 text-center shadow-xl min-w-[110px]">
              <p class="text-2xl font-extrabold text-white leading-none mb-1" style="font-family:'Montserrat',sans-serif;">RGE</p>
              <p class="text-orange-100 text-xs font-medium">Qualibat certifié</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       LES SIGNES
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-[#F0F5FC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Diagnostic</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 leading-tight" style="font-family:'Montserrat',sans-serif;">
          Les signes qui indiquent<br>qu'un remplacement est nécessaire
        </h2>
        <p class="text-gray-600 mt-4 text-lg leading-relaxed">
          Votre sol vous envoie des signaux. Voici les indicateurs à ne pas ignorer.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {signes.map(s => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-md hover:border-[#E8650A]/20 transition-all duration-200">
            <span class="inline-flex items-center gap-1 bg-[#E8650A]/10 text-[#E8650A] text-xs font-semibold px-2.5 py-1 rounded-full mb-4">
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
              Alerte
            </span>
            <h3 class="font-bold text-[#1E4B8C] text-base mb-2" style="font-family:'Montserrat',sans-serif;">{s.titre}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOS REVÊTEMENTS DE SOLS
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Nos savoir-faire</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 leading-tight" style="font-family:'Montserrat',sans-serif;">
          Nos revêtements<br>de sols
        </h2>

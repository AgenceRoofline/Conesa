---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZonesIntervention from '../components/ZonesIntervention.astro';

const prestations = [
  {
    titre: "Nettoyage de toiture",
    desc: "Élimination des salissures, dépôts de pollution, traces noires et résidus organiques par nettoyage adapté au support. Technique douce ou haute pression selon les matériaux pour respecter l'intégrité de votre couverture.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>`,
  },
  {
    titre: "Démoussage",
    desc: "Retrait mécanique et chimique des mousses, lichens et algues installés sur les tuiles. Un démoussage soigneux protège la couverture et évite que la végétation ne s'insinue entre les matériaux pour les dégrader progressivement.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
  },
  {
    titre: "Traitement antimousse",
    desc: "Application d'un traitement antimousse en phase préventive après nettoyage pour limiter fortement la repousse. Le produit agit en profondeur dans les pores des tuiles et offre une protection durable contre lichens, algues et mousses.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    titre: "Traitement hydrofuge",
    desc: "Imperméabilisation de la toiture par application d'un produit hydrofuge en finition. Limite la pénétration de l'eau dans les matériaux, ralentit le vieillissement des tuiles et prolonge significativement la durée de vie de la couverture.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
];

const signes = [
  {
    titre: "Présence de mousses et lichens",
    desc: "Des taches vertes, des touffes de mousse ou des lichens sur les tuiles signalent une humidité persistante à la surface de la couverture. Ces végétaux retiennent l'eau, s'insinuent entre les matériaux et accélèrent progressivement leur dégradation.",
  },
  {
    titre: "Tuiles qui changent de couleur",
    desc: "Des traces noires, des taches sombres ou une décoloration générale des tuiles témoignent de l'accumulation de salissures et de pollution. Ces dépôts rendent les tuiles poreuses et réduisent leurs capacités de protection contre les intempéries.",
  },
  {
    titre: "Gouttières encombrées ou débordantes",
    desc: "Des gouttières pleines de débris, de mousse ou de terre signalent un encrassement général de la toiture. Un écoulement difficile des eaux pluviales peut provoquer des infiltrations en rive de toiture et accélérer la dégradation des chenaux.",
  },
  {
    titre: "Toiture vieillissante ou terne",
    desc: "Une toiture qui a perdu son éclat, dont les tuiles sont ternes ou irrégulières, mérite un entretien préventif. Intervenir avant l'apparition de désordres visibles permet d'éviter des réparations bien plus coûteuses à terme.",
  },
];

const avantages = [
  {
    titre: "Sécurité d'intervention garantie",
    desc: "Travailler en hauteur sur une toiture présente des risques importants sans équipement adapté. Nos techniciens interviennent avec les équipements de protection individuels et collectifs requis pour travailler en toute sécurité sur votre couverture.",
  },
  {
    titre: "Diagnostic complet de la toiture",
    desc: "Au-delà du nettoyage, notre intervention inclut une inspection complète de l'état de la couverture : tuiles cassées ou déplacées, faîtière à reprendre, noue endommagée. Vous bénéficiez d'un état des lieux précis avant toute intervention.",
  },
  {
    titre: "Produits adaptés aux matériaux",
    desc: "Tuiles terre cuite, ardoises, bac acier, béton : chaque matériau nécessite des produits et des techniques spécifiques. Nos équipes choisissent les traitements adaptés pour préserver l'intégrité de votre couverture sans l'endommager.",
  },
  {
    titre: "Résultats durables dans le temps",
    desc: "Un entretien professionnel réalisé dans les règles de l'art produit des résultats qui durent. L'association nettoyage + traitement antimousse + hydrofuge offre une protection complète qui retarde significativement le prochain entretien nécessaire.",
  },
];

const etapes = [
  { num: "01", titre: "Inspection de la couverture", desc: "Analyse complète de l'état de la toiture : tuiles, faîtière, noues, gouttières, végétation présente. Nous identifions les besoins et déterminons les techniques d'intervention les plus adaptées à votre support." },
  { num: "02", titre: "Préparation du chantier", desc: "Mise en place des protections collectives, bâchage des abords et sécurisation de la zone de travail. Vos aménagements extérieurs, fenêtres et menuiseries sont protégés avant le début des opérations." },
  { num: "03", titre: "Nettoyage et démoussage", desc: "Retrait mécanique des végétaux puis nettoyage du support par la technique adaptée au matériau. Nous travaillons dans le respect des tuiles pour éliminer salissures, mousses et lichens sans abîmer la couverture." },
  { num: "04", titre: "Application des traitements", desc: "Application du traitement antimousse pour limiter la repousse, puis du traitement hydrofuge pour imperméabiliser la toiture. Les produits sont sélectionnés selon votre support et les conditions climatiques du Tarn." },
  { num: "05", titre: "Contrôle final et conseils", desc: "Vérification complète du chantier, nettoyage des abords et remise en état. Nous vous communiquons nos observations sur l'état général de la couverture et vous conseillons sur la fréquence d'entretien à prévoir." },
];

const engagements = [
  "Plus de 55 ans d'expérience en rénovation dans le Tarn",
  "Entreprise familiale et équipes locales",
  "Connaissance des toitures et du climat du Tarn (81)",
  "Devis gratuit, détaillé et sans engagement",
  "Garantie décennale sur les travaux réalisés",
  "Accompagnement personnalisé de A à Z",
  "Interlocuteur unique pour tout votre chantier",
];

const villes = ["Albi", "Gaillac", "Castres", "Graulhet", "Lavaur", "Carmaux", "Mazamet", "Saint-Sulpice"];

const villesLinks: Record<string, string> = {
  "Albi": "/villes/albi",
  "Gaillac": "/villes/gaillac",
  "Castres": "/villes/castres",
  "Graulhet": "/villes/graulhet",
};

const faqs = [
  {
    q: "À quelle fréquence faut-il nettoyer sa toiture ?",
    a: "Un entretien tous les 3 à 5 ans est généralement recommandé, mais cela dépend de l'exposition de la toiture, de son orientation et des conditions climatiques locales. Dans le Tarn, les zones humides et ombragées favorisent le développement rapide des mousses et peuvent nécessiter un entretien plus régulier. Un diagnostic gratuit permet d'évaluer l'état réel de votre couverture.",
  },
  {
    q: "Pourquoi les mousses apparaissent-elles sur les tuiles ?",
    a: "Les mousses se développent dans les endroits humides, peu ventilés et partiellement à l'ombre. Elles se fixent sur les tuiles poreuses, retiennent l'humidité et créent des conditions favorables à leur propre prolifération. Les lichens, eux, s'attaquent directement à la surface des matériaux. Le climat du Tarn, avec ses hivers humides et ses variations thermiques, est propice à leur développement.",
  },
  {
    q: "Le démoussage est-il obligatoire ?",
    a: "Non, il n'est pas légalement obligatoire. Mais il est fortement recommandé dès que des mousses ou des lichens sont visibles sur la toiture. Sans intervention, ces végétaux continuent de se développer, retiennent l'humidité et accélèrent la dégradation des tuiles. Le démoussage préventif coûte bien moins cher qu'une rénovation complète de couverture.",
  },
  {
    q: "Le traitement hydrofuge est-il vraiment utile ?",
    a: "Oui, le traitement hydrofuge est une protection complémentaire très efficace après un nettoyage ou un démoussage. Il imperméabilise les pores des tuiles tout en laissant les matériaux respirer, ce qui limite la pénétration de l'eau de pluie et ralentit le retour des mousses. C'est un investissement modéré qui prolonge significativement la durée de vie de la couverture.",
  },
  {
    q: "Peut-on nettoyer une toiture soi-même ?",
    a: "C'est techniquement possible, mais déconseillé. Travailler en hauteur sur une toiture sans équipement adapté est dangereux. De plus, une pression trop forte peut casser des tuiles ou abîmer les joints. Les produits professionnels sont plus efficaces et mieux dosés que les produits du commerce. Faire appel à un professionnel garantit un résultat durable sans risque pour vous ni pour votre toiture.",
  },
  {
    q: "Combien coûte un nettoyage de toiture ?",
    a: "Le tarif varie selon la surface de la toiture, son accessibilité, son état et les prestations réalisées (simple nettoyage, démoussage, traitement antimousse, hydrofuge). Contactez-nous pour obtenir un devis gratuit et personnalisé. Un technicien Conesa se déplace pour évaluer votre toiture et vous proposer la solution adaptée à votre budget.",
  },
  {
    q: "Combien de temps durent les travaux ?",
    a: "Pour une maison individuelle, un nettoyage complet avec démoussage et traitement se réalise généralement en 1 à 2 jours selon la surface et l'état de la toiture. Un planning précis vous est communiqué dès l'établissement du devis. Nos équipes s'organisent pour intervenir rapidement et minimiser la gêne occasionnée.",
  },
  {
    q: "Comment obtenir un devis gratuit ?",
    a: "Remplissez notre formulaire de contact, appelez-nous au 05 63 54 16 97 ou envoyez-nous un email. Un technicien Conesa se déplace gratuitement pour évaluer l'état de votre toiture et vous remettre un devis détaillé, sans engagement de votre part, sous 24 h.",
  },
];

const jsonLdService = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Nettoyage et entretien de toiture",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Conesa",
    "telephone": "+33563541697",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Albi",
      "postalCode": "81000",
      "addressCountry": "FR"
    }
  },
  "areaServed": { "@type": "AdministrativeArea", "name": "Tarn" },
  "description": "Nettoyage, démoussage et traitement hydrofuge de toiture dans le Tarn. Entretien professionnel par Conesa.",
  "url": "https://conesa-renovation.fr/nettoyage-toiture"
});

const jsonLdBreadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://conesa-renovation.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Nettoyage de toiture", "item": "https://conesa-renovation.fr/nettoyage-toiture" }
  ]
});

const jsonLdFaq = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
});
---

<BaseLayout
  title="Nettoyage et démoussage de toiture dans le Tarn | Conesa"
  description="Nettoyage, démoussage et traitement hydrofuge de toiture dans le Tarn. Préservez durablement votre couverture avec l'expertise Conesa."
>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdService} />
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdBreadcrumb} />
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdFaq} />

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-[#0A1E3D]" style="padding-top: 200px; padding-bottom: 96px;">
    <img
      src={encodeURI("/images/Page nettoyage toiture/Hero nettoyage toiture.png")}
      alt="Nettoyage et entretien de toiture dans le Tarn — Conesa"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      fetchpriority="high"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,30,61,0.92) 0%, rgba(30,75,140,0.78) 60%, rgba(10,30,61,0.72) 100%);"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="absolute top-0 left-0 w-1 h-full bg-[#E8650A] opacity-60"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Fil d'Ariane -->
      <nav class="flex items-center gap-2 text-white/50 text-sm mb-8" aria-label="Fil d'Ariane">
        <a href="/" class="hover:text-white transition-colors">Accueil</a>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white/80">Nettoyage de toiture</span>
      </nav>

      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 text-sm font-medium text-white mb-8">
          <span class="w-2 h-2 bg-[#E8650A] rounded-full"></span>
          Entreprise familiale dans le Tarn depuis 1969
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-[3rem] font-extrabold text-white leading-[1.1] mb-6" style="font-family:'Montserrat',sans-serif;">
          Nettoyage et entretien<br>de toiture
          <span class="text-[#E8650A]"> dans le Tarn</span>
        </h1>
        <p class="text-blue-100 text-lg leading-relaxed mb-10 max-w-xl">
          La toiture est l'élément le plus exposé de votre habitation. Conesa réalise vos travaux de nettoyage, démoussage et traitement hydrofuge dans tout le département du Tarn pour préserver durablement votre couverture.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#contact" class="inline-flex items-center justify-center gap-2 bg-[#E8650A] hover:bg-orange-700 text-white font-bold px-8 py-4 rounded-xl transition-all duration-200 hover:scale-105 shadow-lg shadow-orange-900/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Demander un devis gratuit
          </a>
          <a href="tel:0563541697" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-semibold px-8 py-4 rounded-xl transition-all duration-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            05 63 54 16 97
          </a>
        </div>
        <div class="flex items-center gap-4">
          <img src="/images/labels/Logo-RGE.png" alt="RGE Qualibat" class="h-11 w-auto bg-white rounded-lg p-1 shadow" loading="lazy" decoding="async" onerror="this.style.display='none'"/>
          <span class="text-blue-100 text-sm">Certifié RGE &amp; Qualibat — Devis gratuit sous 24 h</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       POURQUOI ENTRETENIR SA TOITURE
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Pourquoi entretenir ?</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 mb-6 leading-tight" style="font-family:'Montserrat',sans-serif;">
            Pourquoi entretenir sa toiture régulièrement ?
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Beaucoup de propriétaires attendent l'apparition d'une fuite ou d'un désordre visible avant d'intervenir sur leur toiture. Pourtant, un entretien préventif régulier permet souvent d'éviter des réparations importantes et particulièrement coûteuses.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Tout au long de l'année, votre toiture subit les effets du soleil, de la pluie, du vent, du gel et de l'humidité. Ces agressions favorisent l'apparition de mousses, de lichens et de dépôts qui accélèrent le vieillissement des matériaux si rien n'est fait.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              "Limiter le développement des mousses et des lichens",
              "Préserver l'étanchéité de la couverture",
              "Éviter la porosité et la fissuration des tuiles",
              "Prolonger la durée de vie de la toiture",
              "Prévenir les infiltrations d'eau",
              "Conserver une toiture esthétique et valorisante",
            ].map(item => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full bg-[#E8650A] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="relative rounded-2xl overflow-hidden shadow-2xl" style="min-height:340px;">
            <img
              src={encodeURI("/images/Page nettoyage toiture/Entretien toiture.png")}
              alt="Entretien et nettoyage de toiture — Conesa, entreprise familiale dans le Tarn"
              class="w-full h-full object-cover object-center absolute inset-0"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,30,61,0.45) 0%, rgba(10,30,61,0.08) 45%, transparent 100%);"></div>
          </div>
          <div class="relative z-10 -mt-9 flex items-center justify-center gap-3 flex-wrap px-6">
            {[
              { val: "55+", label: "ans d'expérience" },
              { val: "500+", label: "chantiers Tarn" },
            ].map(item => (
              <div class="bg-[#1E4B8C]/80 backdrop-blur-md border border-white/20 rounded-xl px-5 py-3 text-center shadow-xl min-w-[110px]">
                <p class="text-2xl font-extrabold text-white leading-none mb-1" style="font-family:'Montserrat',sans-serif;">{item.val}</p>
                <p class="text-blue-200 text-xs font-medium">{item.label}</p>
              </div>
            ))}
            <div class="bg-[#E8650A]/85 backdrop-blur-md border border-white/20 rounded-xl px-5 py-3 text-center shadow-xl min-w-[110px]">
              <p class="text-2xl font-extrabold text-white leading-none mb-1" style="font-family:'Montserrat',sans-serif;">RGE</p>
              <p class="text-orange-100 text-xs font-medium">Qualibat certifié</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       LES SIGNES
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-[#F0F5FC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Diagnostic</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 leading-tight" style="font-family:'Montserrat',sans-serif;">
          Les signes qui indiquent<br>qu'un nettoyage est nécessaire
        </h2>
        <p class="text-gray-600 mt-4 text-lg leading-relaxed">
          Votre toiture vous envoie des signaux. Voici les alertes à ne pas ignorer.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {signes.map(s => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-md hover:border-[#E8650A]/20 transition-all duration-200">
            <span class="inline-flex items-center gap-1 bg-[#E8650A]/10 text-[#E8650A] text-xs font-semibold px-2.5 py-1 rounded-full mb-4">
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
              Alerte
            </span>
            <h3 class="font-bold text-[#1E4B8C] text-base mb-2" style="font-family:'Montserrat',sans-serif;">{s.titre}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOS PRESTATIONS
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

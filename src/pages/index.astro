    /* ── Mobile + Tablette : deck empilé ── */
    @media (max-width: 1023px) {
      .pp-zoom.pp-active {
        position: relative;
        z-index: 10;
        box-shadow: 0 8px 32px rgba(43,38,34,0.18);
      }
      .pp-zoom.pp-inactive {
        position: absolute;
        top: 0;
        left: 4px;
        right: 4px;
        z-index: 5;
        transform: scale(0.96);
        transform-origin: top center;
        box-shadow: 0 4px 0 2px rgba(43,38,34,0.08), 0 8px 0 4px rgba(43,38,34,0.05);
        cursor: pointer;
        border-radius: 4px;
        overflow: hidden;
      }
    }

    /* ── Desktop : zoom / flou ── */
    @media (min-width: 1024px) {
      .pp-zoom {
        position: relative;
        z-index: 1;
      }
      .pp-zoom.pp-active {
        transform: scale(1.05);
        z-index: 10;
        cursor: default;
        box-shadow: 0 24px 64px rgba(0,0,0,0.18);
      }
      .pp-zoom.pp-inactive {
        filter: blur(3px);
        opacity: 0.5;
        z-index: 0;
      }
    }
  </style>

  <script>
  (function () {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.pp-zoom'));
    const defaultActive = document.getElementById('pp-part');
    if (!defaultActive) return;

    cards.forEach(c => c.classList.remove('pp-active', 'pp-inactive'));
    defaultActive.classList.add('pp-active');
    cards.filter(c => c !== defaultActive).forEach(c => c.classList.add('pp-inactive'));

    cards.forEach(card => {
      card.addEventListener('click', () => {
        cards.forEach(c => c.classList.remove('pp-active', 'pp-inactive'));
        card.classList.add('pp-active');
        cards.filter(c => c !== card).forEach(c => c.classList.add('pp-inactive'));
      });
    });
  })();
  </script>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import RealisationsCarousel from '../components/RealisationsCarousel.astro';
import ZonesIntervention from '../components/ZonesIntervention.astro';

const stats = [
  { value: "55+",   label: "ans d'expérience",    color: "#C4362C" },
  { value: "500+",  label: "chantiers réalisés",   color: "#D98A2B" },
  { value: "RGE",   label: "& Qualibat certifié",  color: "#4A8F52" },
  { value: "4,6/5", label: "avis clients Google",  color: "#2F6FA8" },
];


const reasons = [
  {
    num: "01",
    titre: "Prise de contact",
    desc: "Appelez-nous ou remplissez le formulaire. Nous vous répondons sous 24 h pour échanger sur votre projet.",
  },
  {
    num: "02",
    titre: "Visite & devis gratuit",
    desc: "Un technicien se déplace chez vous pour évaluer les travaux et vous remettre un devis détaillé, sans engagement.",
  },
  {
    num: "03",
    titre: "Montage des aides",
    desc: "Nous identifions toutes les aides auxquelles vous avez droit (MaPrimeRénov', CEE, éco-PTZ) et constituons les dossiers.",
  },
  {
    num: "04",
    titre: "Réalisation des travaux",
    desc: "Nos équipes interviennent selon le planning convenu, dans le respect des délais et de votre quotidien.",
  },
  {
    num: "05",
    titre: "Réception & suivi",
    desc: "Visite de fin de chantier avec vous, levée des réserves et suivi après livraison pour votre tranquillité.",
  },
];

const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    titre: "Isolation thermique extérieure",
    desc: "Améliorez vos performances énergétiques tout en rénovant votre façade. Travaux réalisés par des experts certifiés RGE, avec accompagnement des aides financières.",
    detail: ["Jusqu'à 30% d'économies sur vos factures de chauffage", "Aides MaPrimeRénov', Éco-PTZ et CEE disponibles"],
    href: "/isolation",
    image: "/images/Page-isolation-ext/Isolation par l'extérieur - Conesa.png",
    color: "#2F6FA8",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    titre: "Ravalement de façade",
    desc: "Redonnez une seconde jeunesse à votre façade : nettoyage, traitement des fissures, enduits et rénovation complète.",
    detail: ["Nettoyage haute pression, rebouchage des fissures et reprise des joints", "Enduits, peintures et finitions durables adaptés à chaque support"],
    href: "/ravalement-facade",
    image: "/images/Page ravalement de façade/Rénoavtion de façade - Conesa.png",
    color: "#C4362C",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`,
    titre: "Peinture intérieure & extérieure",
    desc: "Des finitions soignées pour embellir et protéger durablement votre habitation, avec conseil couleurs et accompagnement personnalisé.",
    detail: ["Préparation soignée des supports : enduit, ponçage, impressions", "Peintures haut de gamme, conseils couleurs et finitions sur mesure"],
    href: "/peinture-interieure-exterieure",
    image: "/images/Page peinture interieure exterieure/Peinture intérieur et extérieure.png",
    color: "#B02A5B",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
    titre: "Nettoyage & entretien de toiture",
    desc: "Préservez votre toiture grâce à nos prestations de nettoyage, démoussage et traitement hydrofuge.",
    detail: ["Démoussage, nettoyage basse pression et traitement hydrofuge", "Prolonge la durée de vie de votre couverture de 10 à 15 ans"],
    href: "/nettoyage-toiture",
    image: "/images/Page nettoyage toiture/Entretien toiture.png",
    color: "#4A8F52",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>`,
    titre: "Revêtements de sols",
    desc: "Pose de revêtements adaptés à vos besoins esthétiques et techniques, pour des finitions impeccables.",
    detail: ["Carrelage, parquet, stratifié, vinyl et résine époxy", "Dépose de l'ancien revêtement et préparation du support incluses"],
    href: "/revetements-sols",
    image: "/images/Page revetements sols/Revêtement de sol.png",
    color: "#D98A2B",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    titre: "Travaux après sinistre",
    desc: "Intervention rapide pour remettre votre habitation en état après un dégât des eaux ou tout autre sinistre.",
    detail: ["Intervention sous 48 h, coordination avec votre assurance", "Remise en état complète : peinture, sols, placo et menuiseries"],
    href: "/travaux-apres-sinistre",
    image: "/images/Page travaux apres sinistre/Travaux après sinistre.png",
    color: "#D9B43A",
  },
];

const articles = [
  {
    href: "/blog/isolation-interieure-ou-exterieure",
    categorie: "Isolation",
    titre: "Isolation intérieure ou extérieure : quelle solution choisir ?",
    description: "Comparez l'isolation thermique par l'intérieur et par l'extérieur : avantages, performances, coûts et aides disponibles pour bien choisir.",
    image: "/images/blog/Isolation-intérieure-ou-extérieure/hero isolation-interieure-exterieure.png",
    badge: "bg-[#E8F0FB] text-[#1E4B8C]",
  },
  {
    href: "/blog/demoussage-toiture-pourquoi-ne-pas-attendre",
    categorie: "Toiture",
    titre: "Démoussage de toiture : pourquoi ne faut-il pas attendre ?",
    description: "Mousses, lichens, infiltrations… Découvrez pourquoi un entretien régulier de votre toiture évite des réparations bien plus coûteuses.",
    image: "/images/blog/Démoussage-de-toiture/Hero Démoussage de toiture.png",
    badge: "bg-orange-50 text-[#E8650A]",
  },
  {
    href: "/blog/renovation-energetique-plus-value-maison",
    categorie: "Rénovation",
    titre: "Comment la rénovation énergétique valorise votre maison ?",
    description: "Isolation, façade, DPE : comment les travaux de rénovation améliorent votre confort quotidien et augmentent la valeur immobilière de votre bien.",
    image: "/images/blog/valoriser-votre-maison/Hero valoriser votre maison.png",
    badge: "bg-[#E8F0FB] text-[#1E4B8C]",
  },
  {
    href: "/blog/comment-savoir-si-votre-facade-a-besoin-dun-ravalement",
    categorie: "Façade",
    titre: "Comment savoir si votre façade a besoin d'un ravalement ?",
    description: "Fissures, mousses, enduit dégradé, humidité : apprenez à reconnaître les signes qui indiquent qu'un ravalement de façade s'impose.",
    image: "/images/blog/façade-a-besoin-d-un-ravalement/Hero façade a besoin d'un ravalement.png",
    badge: "bg-orange-50 text-[#E8650A]",
  },
];

const avis = [
  {
    nom: "Vanessa D.",
    texte: "Travail exceptionnel pour l'isolation extérieure de ma maison. Une équipe au top, professionnelle et très soignée. Les conseils ont été précieux et m'ont parfaitement guidée dans mes choix. Résultat impeccable, ma maison est comme neuve. Je recommande cette entreprise les yeux fermés.",
    service: "Isolation thermique extérieure",
  },
  {
    nom: "Alain",
    texte: "Entreprise très sérieuse et professionnelle. Le travail réalisé est de grande qualité. Le chantier a été protégé et laissé dans un état de propreté irréprochable. Nous avons été informés régulièrement de l'avancement des travaux. Terminé dans les délais annoncés. Je recommande vivement.",
    service: "Isolation thermique extérieure",
  },
  {
    nom: "Philippe M.",
    texte: "Réfection complète de notre façade. Travail particulièrement soigné et personnel très discret, tout en restant à l'écoute du client. Excellent relationnel avec les responsables de l'entreprise. Nous sommes ravis du résultat.",
    service: "Ravalement de façade",
  },
  {
    nom: "Nicolas S.",
    texte: "Très bonne entreprise à l'écoute de nos projets. Une équipe jeune, dynamique et des travaux propres et soignés. Isolation par l'extérieur et peinture intérieure réalisées avec un résultat irréprochable. Un mur décoratif imitation brique réalisé à la main et un stuc parfaitement exécuté dans le salon.",
    service: "ITE & Peinture intérieure",
  },
  {
    nom: "Martine A.",
    texte: "Je tiens à exprimer ma profonde satisfaction concernant le travail réalisé. L'expertise et le sens du détail ont véritablement transformé mon espace. Très professionnel, minutieux et à l'écoute, il a su répondre à toutes mes attentes. Je recommande vivement pour l'excellent service et la qualité du travail.",
    service: "Rénovation intérieure",
  },
  {
    nom: "Bénédicte",
    texte: "Travail de qualité et chantier laissé parfaitement propre à la fin des travaux. Mention spéciale à Alexandre qui a réalisé les travaux avec beaucoup de professionnalisme tout en restant très sympathique. Je recommande cette entreprise.",
    service: "Rénovation de l'habitat",
  },
];

const faqs = [
  {
    q: "Quel est le prix d'une isolation thermique extérieure ?",
    a: "Le coût varie selon la surface, les matériaux et la configuration du logement. Comptez généralement entre 100 et 200 €/m² posé. Contactez-nous pour un devis gratuit et personnalisé.",
  },
  {
    q: "Quelles aides financières sont disponibles pour mon projet ?",
    a: "Plusieurs aides existent : MaPrimeRénov', l'Éco-PTZ, la TVA à 5,5 %, les CEE et les aides de l'Anah. Étant certifié RGE, Conesa vous permet d'y accéder. Nous vous guidons dans vos démarches.",
  },
  {
    q: "Intervenez-vous dans tout le Tarn ?",
    a: "Oui, nos équipes interviennent dans l'ensemble du département du Tarn (81) : Albi, Gaillac, Castres, Graulhet, Carmaux, Lavaur, Réalmont, Mazamet, Saint-Sulpice et leurs environs.",
  },
  {
    q: "Combien coûte un ravalement de façade ?",
    a: "Le prix dépend de la superficie, de l'état de la façade et des prestations choisies. Demandez un devis gratuit pour obtenir une estimation précise.",
  },
  {
    q: "Sous quels délais pouvez-vous intervenir ?",
    a: "Nous faisons le maximum pour répondre rapidement à vos demandes. Le délai varie selon la nature des travaux et notre planning. Contactez-nous pour connaître nos disponibilités.",
  },
  {
    q: "Comment obtenir un devis gratuit ?",
    a: "Remplissez notre formulaire en ligne, appelez-nous ou envoyez-nous un email. Nous vous recontactons sous 24h pour fixer un rendez-vous et établir un devis gratuit sur mesure.",
  },
];
---

<BaseLayout
  title="Isolation & Rénovation dans le Tarn"
  description="Isolation thermique extérieure, ravalement de façade et rénovation dans le Tarn. Entreprise familiale certifiée RGE depuis 1969. Devis gratuit."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Conesa",
    "image": "https://conesa-renovation.fr/images/Logo/Logo-Conesa.svg",
    "description": "Entreprise familiale de rénovation et isolation thermique extérieure dans le Tarn (81) depuis 1969. Certifiée RGE et Qualibat.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "31 Petit Chemin des Broucouniès",
      "addressLocality": "Albi",
      "postalCode": "81000",
      "addressRegion": "Occitanie",
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 43.9527,
      "longitude": 2.1513
    },
    "telephone": "+33563541697",
    "email": "conesa81@wanadoo.fr",
    "url": "https://conesa-renovation.fr",
    "foundingDate": "1969",
    "priceRange": "€€",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.6",
      "ratingCount": "50",
      "bestRating": "5",
      "worstRating": "1"
    },
    "areaServed": [
      { "@type": "City", "name": "Albi" },
      { "@type": "City", "name": "Gaillac" },
      { "@type": "City", "name": "Castres" },
      { "@type": "City", "name": "Graulhet" },
      { "@type": "AdministrativeArea", "name": "Tarn" }
    ],
    "sameAs": [
      "https://www.facebook.com/sarl.conesa/"
    ]
  })} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-[#2B2622]" style="min-height:100vh;display:flex;align-items:center;">
    <!-- Mobile -->
    <img
      src={encodeURI("/images/Page accueil/Hero page d'acceuil - Conesa Mobile.png")}
      alt="Chantier de rénovation et isolation thermique extérieure dans le Tarn — Conesa"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center sm:hidden"
      fetchpriority="high"
    />
    <!-- Tablette & Desktop -->
    <img
      src={encodeURI("/images/Page accueil/Hero page d'acceuil - Conesa.png")}
      alt="Chantier de rénovation et isolation thermique extérieure dans le Tarn — Conesa"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover hidden sm:block"
      style="object-position: left center;"
      fetchpriority="high"
    />
    <!-- Overlay brun chaud -->
    <div class="absolute inset-0" style="background: linear-gradient(98deg, rgba(43,38,34,0.78) 0%, rgba(43,38,34,0.62) 50%, rgba(43,38,34,0.10) 100%);"></div>

    <!-- Tampon 1969 -->
    <div class="absolute bottom-8 right-6 sm:right-10 w-20 h-20 sm:w-24 sm:h-24 rounded-full flex flex-col items-center justify-center text-center pointer-events-none" style="border: 2px solid rgba(233,222,211,0.45); transform: rotate(-8deg);">
      <span class="text-[#E9DED3] font-bold" style="font-family:'Bitter',serif; font-size:8px; letter-spacing:0.14em;">DEPUIS</span>
      <span class="text-white font-extrabold leading-none" style="font-family:'Bitter',serif; font-size:22px;">1969</span>
      <span class="text-[#E9DED3] font-bold" style="font-family:'Bitter',serif; font-size:7px; letter-spacing:0.1em;">ALBI · TARN</span>
    </div>

    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24 lg:pt-44 lg:pb-32">
      <div class="max-w-2xl text-white">

        <!-- Filet arc-en-ciel -->
        <div class="flex mb-7 rounded-sm overflow-hidden" style="width:138px; height:5px;">
          <div style="flex:1; background:#C4362C;"></div>
          <div style="flex:1; background:#D98A2B;"></div>
          <div style="flex:1; background:#D9B43A;"></div>
          <div style="flex:1; background:#4A8F52;"></div>
          <div style="flex:1; background:#2F6FA8;"></div>
          <div style="flex:1; background:#B02A5B;"></div>
        </div>

        <!-- Sous-titre petites capitales -->
        <p class="font-bold mb-4" style="font-family:'Bitter',serif; font-size:12px; letter-spacing:0.14em; text-transform:uppercase; color:#E0D2C4;">
          Entreprise familiale dans le Tarn depuis 1969
        </p>

        <h1 class="font-extrabold leading-[1.14] mb-6 text-4xl sm:text-5xl lg:text-[3.1rem]" style="font-family:'Bitter',serif;">
          Isolation Thermique Extérieure,
          <br>Façade &amp; Rénovation
          <br><span style="color:#D98A2B;">dans le Tarn</span>
        </h1>

        <p class="leading-relaxed mb-10 max-w-xl text-base md:text-lg" style="color:#E4DCD3;">
          Depuis plus de 55 ans, Conesa accompagne les particuliers dans leurs projets d'isolation extérieure, rénovation de façade et entretien de l'habitat dans tout le département du Tarn.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a href="#contact" class="inline-flex items-center justify-center gap-3 text-white font-bold px-8 py-4 transition-all duration-200 hover:opacity-90" style="background:#A8442A; border-radius:3px;">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Demander un devis gratuit
          </a>
          <a href="tel:0563541697" class="inline-flex items-center justify-center gap-3 font-semibold px-8 py-4 transition-all duration-200 hover:bg-white/5" style="border:1.5px solid #E9DED3; color:#E9DED3; border-radius:3px;">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Être rappelé
          </a>
        </div>

        <!-- Badge RGE -->
        <div class="flex items-center gap-3 pt-8" style="border-top: 1px solid rgba(233,222,211,0.18);">
          <img src="/images/labels/Logo-RGE.png" alt="RGE Qualibat" class="h-11 w-auto bg-white p-1 shadow" style="border-radius:3px;" loading="lazy" decoding="async" />
          <span class="text-sm" style="color:#C9BEB2;">Certifié RGE &amp; Qualibat</span>
        </div>

      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section style="background-color:#E9DED3; background-image:radial-gradient(circle at 30% 40%, rgba(43,38,34,0.06) 1px, transparent 1.4px), radial-gradient(circle at 70% 80%, rgba(43,38,34,0.04) 1px, transparent 1.4px); background-size:7px 7px, 11px 11px;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {stats.map((s) => (
          <div class="text-center">
            <p class="text-3xl font-extrabold leading-none" style={`font-family:'Bitter',serif; color:#2B2622;`}>{s.value}</p>
            <div class="mx-auto mt-2 mb-1.5 rounded-full" style={`width:30px; height:3px; background:${s.color};`}></div>
            <p class="text-sm" style="color:#6B6156;">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PRÉSENTATION DE L'ENTREPRISE
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24" style="background:#FAF6F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="font-semibold text-sm uppercase tracking-widest" style="color:#A8442A;">Entreprise familiale depuis 1969</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 mb-3 leading-tight" style="font-family:'Bitter',serif; color:#2B2622;">
            Une entreprise familiale au service de votre habitat depuis plus de 55 ans
          </h2>
          <!-- Filet arc-en-ciel -->
          <div class="flex mb-6 rounded-sm overflow-hidden" style="width:108px; height:4px;">
            <div style="flex:1; background:#C4362C;"></div>
            <div style="flex:1; background:#D98A2B;"></div>
            <div style="flex:1; background:#4A8F52;"></div>
            <div style="flex:1; background:#B02A5B;"></div>
          </div>
          <p class="leading-relaxed mb-4" style="color:#4B4238;">
            Depuis plus de 55 ans, Conesa accompagne les particuliers, professionnels et collectivités dans leurs projets de rénovation et d'amélioration de l'habitat dans tout le Tarn. Entreprise familiale implantée à Albi, nous intervenons sur des travaux de façade, d'isolation thermique extérieure, de peinture, de revêtements de sols, d'entretien de toiture et de remise en état après sinistre.

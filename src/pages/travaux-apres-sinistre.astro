---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZonesIntervention from '../components/ZonesIntervention.astro';

const signes = [
  {
    titre: "Dégât des eaux",
    desc: "Fuite, infiltration ou rupture de canalisation — l'humidité résiduelle continue de dégrader murs, plafonds et sols longtemps après l'arrêt de la fuite. Chaque jour sans intervention aggrave les dommages.",
  },
  {
    titre: "Incendie & fumée",
    desc: "Les suies et résidus de fumée s'infiltrent partout, même dans les pièces non touchées par les flammes. Un traitement rapide évite que les traces et les odeurs ne s'imprègnent durablement dans les matériaux.",
  },
  {
    titre: "Tempête & intempéries",
    desc: "Infiltrations d'eau, façade fissurée, toiture endommagée — les intempéries exposent votre habitation à des dégradations progressives si elles ne sont pas traitées rapidement après l'événement.",
  },
  {
    titre: "Catastrophe accidentelle",
    desc: "Explosion, choc, effondrement partiel : tout événement imprévisible peut nécessiter une remise en état complète des murs, plafonds, sols et revêtements pour retrouver un logement sain et sécurisé.",
  },
];

const prestations = [
  {
    titre: "Réfection des plafonds",
    desc: "Traitement des fissures, cloques et zones humides. Reprise des enduits et pose d'une peinture de finition pour retrouver un plafond impeccable, sans trace du sinistre.",
  },
  {
    titre: "Réfection des murs",
    desc: "Reprise des enduits endommagés, élimination des traces de fumée ou d'humidité, remise en peinture ou pose de nouveaux revêtements muraux adaptés à votre intérieur.",
  },
  {
    titre: "Revêtements de sols",
    desc: "Dépose des matériaux dégradés (PVC, vinyle, stratifié, moquette) et pose de nouveaux revêtements choisis avec vous pour un rendu cohérent avec l'ensemble du logement.",
  },
  {
    titre: "Travaux de finition",
    desc: "Peinture décorative, menuiseries réparées, finitions soignées : chaque détail est traité pour restituer à votre logement son aspect d'origine et son confort.",
  },
];

const avantages = [
  {
    titre: "Intervention rapide",
    desc: "Après un sinistre, chaque heure compte. Nos équipes se mobilisent rapidement pour évaluer les dommages, sécuriser les zones et lancer les travaux de remise en état sans délai.",
    color: "orange",
  },
  {
    titre: "Interlocuteur unique",
    desc: "Un seul référent coordonne l'ensemble des corps de métier — plafonds, murs, sols, peinture. Moins de stress, une meilleure organisation et un chantier suivi de bout en bout.",
    color: "blue",
  },
  {
    titre: "Accompagnement assurance",
    desc: "Nous vous aidons à constituer un dossier complet (photos, descriptif des dommages, devis détaillé) pour faciliter la prise en charge par votre compagnie d'assurance.",
    color: "orange",
  },
  {
    titre: "55 ans d'expérience",
    desc: "Entreprise familiale dans le Tarn depuis 1969, Conesa maîtrise tous les aspects des travaux intérieurs et extérieurs nécessaires après un sinistre pour une remise en état de qualité.",
    color: "blue",
  },
];

const etapes = [
  { num: "01", titre: "Diagnostic sur place", desc: "Évaluation rapide des zones sinistrées, identification des dommages visibles et cachés (humidité, suies, fragilités structurelles). Nous dressons un état des lieux précis avant toute intervention." },
  { num: "02", titre: "Devis détaillé", desc: "Chiffrage complet de l'ensemble des travaux de remise en état, pièce par pièce. Ce document précis est directement utilisable pour votre déclaration auprès de votre assurance." },
  { num: "03", titre: "Coordination avec l'assurance", desc: "Transmission des éléments nécessaires à votre assureur et collaboration avec l'expert mandaté. Nous adaptons notre planning pour intervenir dans les meilleures conditions après validation." },
  { num: "04", titre: "Réalisation des travaux", desc: "Intervention de nos équipes sur l'ensemble des corps de métier concernés : plafonds, murs, sols, peinture et finitions. Un suivi rigoureux garantit la qualité et le respect des délais." },
  { num: "05", titre: "Remise en état complète", desc: "Livraison du chantier propre et rénové. Vous retrouvez un logement sain, sécurisé et confortable, avec un résultat indiscernable du sinistre initial." },
];

const engagements = [
  "Plus de 55 ans d'expérience en rénovation dans le Tarn",
  "Entreprise familiale et équipes locales",
  "Réactivité et intervention rapide après sinistre",
  "Devis gratuit, détaillé et utilisable pour l'assurance",
  "Interlocuteur unique pour tout le chantier",
  "Accompagnement dans les démarches d'assurance",
  "Garantie décennale sur les travaux réalisés",
];

const faqs = [
  {
    q: "Que faire immédiatement après un dégât des eaux ?",
    a: "Coupez l'eau et l'électricité dans les zones touchées, photographiez les dégâts et contactez votre assurance pour déclarer le sinistre. Contactez ensuite rapidement une entreprise de remise en état comme Conesa — l'humidité peut continuer à dégrader les matériaux plusieurs semaines après l'arrêt de la fuite.",
  },
  {
    q: "Combien de temps faut-il pour remettre un logement en état après un sinistre ?",
    a: "La durée dépend de l'ampleur des dommages. Un dégât des eaux localisé peut être traité en quelques jours, tandis qu'une remise en état complète après incendie peut nécessiter plusieurs semaines. Nous vous fournissons un calendrier précis dès l'établissement du devis.",
  },
  {
    q: "Les travaux après sinistre sont-ils pris en charge par l'assurance ?",
    a: "Dans la grande majorité des cas, oui. Votre assurance habitation couvre les travaux de remise en état après un sinistre reconnu. Nous vous aidons à constituer un dossier complet avec photos, descriptif des dommages et devis détaillé pour faciliter la prise en charge.",
  },
  {
    q: "Faut-il attendre le passage de l'expert avant de commencer les travaux ?",
    a: "Il est généralement conseillé d'attendre l'expertise avant d'engager les travaux importants, sauf pour les mesures d'urgence destinées à éviter l'aggravation (bâchage, pompage, séchage). Nous pouvons intervenir en urgence et coordonner notre planning avec celui de l'expert mandaté.",
  },
  {
    q: "Peut-on refaire uniquement les zones touchées par le sinistre ?",
    a: "Oui, il est possible de n'intervenir que sur les zones endommagées. Nous veillons cependant à garantir une harmonie visuelle avec le reste du logement, notamment pour les peintures et les revêtements, afin que le résultat soit cohérent et soigné.",
  },
  {
    q: "Comment éliminer les traces d'humidité et les odeurs après un sinistre ?",
    a: "Nous commençons par un séchage complet des zones touchées, puis nous traitons les surfaces avec des produits anti-humidité avant de reprendre les enduits et les peintures. Pour les odeurs de fumée, des techniques spécifiques de nettoyage et de traitement des surfaces sont mises en œuvre.",
  },
  {
    q: "Comment obtenir un devis rapidement après un sinistre ?",
    a: "Contactez-nous par téléphone au 05 63 54 16 97 ou via le formulaire de la page. Nous nous déplaçons rapidement sur place dans tout le Tarn pour évaluer les dommages et vous remettre un devis détaillé, utilisable auprès de votre assurance.",
  },
  {
    q: "Dans quelles communes du Tarn intervenez-vous ?",
    a: "Conesa intervient dans tout le département du Tarn : Albi, Gaillac, Castres, Graulhet, Carmaux, Lavaur, Réalmont, Mazamet, Saint-Sulpice et l'ensemble du bassin albigeois. Contactez-nous pour vérifier notre disponibilité dans votre secteur.",
  },
];

const jsonLdService = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Travaux après sinistre",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Conesa",
    "telephone": "+33563541697",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Albi",
      "postalCode": "81000",
      "addressCountry": "FR"
    }
  },
  "areaServed": { "@type": "AdministrativeArea", "name": "Tarn" },
  "description": "Travaux de remise en état après sinistre dans le Tarn. Dégât des eaux, incendie, tempête : Conesa intervient rapidement pour remettre votre logement en état.",
  "url": "https://conesa-renovation.fr/travaux-apres-sinistre"
});

const jsonLdBreadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://conesa-renovation.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Travaux après sinistre", "item": "https://conesa-renovation.fr/travaux-apres-sinistre" }
  ]
});

const jsonLdFaq = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
});
---

<BaseLayout
  title="Travaux après sinistre dans le Tarn | Remise en état | Conesa"
  description="Dégât des eaux, incendie, tempête : Conesa réalise vos travaux de remise en état après sinistre dans tout le Tarn. Devis gratuit."
>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdService} />
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdBreadcrumb} />
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdFaq} />

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-[#0A1E3D]" style="padding-top: 200px; padding-bottom: 96px;">
    <img
      src={encodeURI("/images/Page travaux apres sinistre/Hero travaux après sinistre.png")}
      alt="Travaux après sinistre dans le Tarn — remise en état par Conesa"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      fetchpriority="high"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,30,61,0.92) 0%, rgba(30,75,140,0.78) 60%, rgba(10,30,61,0.72) 100%);"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="absolute top-0 left-0 w-1 h-full bg-[#E8650A] opacity-60"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-white/50 text-sm mb-8" aria-label="Fil d'Ariane">
        <a href="/" class="hover:text-white transition-colors">Accueil</a>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white/80">Travaux après sinistre</span>
      </nav>

      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 text-sm font-medium text-white mb-8">
          <span class="w-2 h-2 bg-[#E8650A] rounded-full"></span>
          Entreprise familiale dans le Tarn depuis 1969
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-[3rem] font-extrabold text-white leading-[1.1] mb-6" style="font-family:'Montserrat',sans-serif;">
          Travaux après sinistre
          <span class="text-[#E8650A]"> dans le Tarn</span>
        </h1>
        <p class="text-blue-100 text-lg leading-relaxed mb-10 max-w-xl">
          Dégât des eaux, incendie ou tempête — une remise en état rapide est essentielle pour limiter l'aggravation des dommages. Depuis plus de 55 ans, Conesa accompagne les particuliers et professionnels du Tarn dans leurs travaux de rénovation après sinistre.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#contact" class="inline-flex items-center justify-center gap-2 bg-[#E8650A] hover:bg-orange-700 text-white font-bold px-8 py-4 rounded-xl transition-all duration-200 hover:scale-105 shadow-lg shadow-orange-900/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Demander un devis gratuit
          </a>
          <a href="tel:0563541697" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-semibold px-8 py-4 rounded-xl transition-all duration-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            05 63 54 16 97
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PRÉSENTATION
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Une prise en charge rapide</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 mb-6 leading-tight" style="font-family:'Montserrat',sans-serif;">
            Intervenir rapidement pour limiter<br>l'aggravation des dommages
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Après un sinistre, la rapidité d'intervention est essentielle. L'humidité résiduelle après un dégât des eaux, les suies après un incendie ou les infiltrations liées à une tempête peuvent continuer à dégrader le bâtiment plusieurs semaines après l'événement.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Nos équipes interviennent pour évaluer les dommages, sécuriser les zones concernées et lancer les travaux de remise en état dans les meilleurs délais. L'objectif : vous permettre de retrouver un logement sain, sécurisé et parfaitement rénové.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              "Évaluation rapide des dommages sur place",
              "Sécurisation des zones sinistrées",
              "Devis détaillé utilisable pour l'assurance",
              "Coordination complète des corps de métier",
              "Remise en état de A à Z en un seul chantier",
              "Interlocuteur unique du diagnostic à la livraison",
            ].map(item => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full bg-[#E8650A] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="relative rounded-2xl overflow-hidden shadow-2xl" style="min-height:340px;">
            <img
              src={encodeURI("/images/Page travaux apres sinistre/Travaux après sinistre.png")}
              alt="Travaux de remise en état après sinistre — Conesa, entreprise familiale dans le Tarn"
              class="w-full h-full object-cover object-center absolute inset-0"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,30,61,0.45) 0%, rgba(10,30,61,0.08) 45%, transparent 100%);"></div>
          </div>
          <div class="relative z-10 -mt-9 flex items-center justify-center gap-3 flex-wrap px-6">
            {[
              { val: "55+", label: "ans d'expérience" },
              { val: "Tarn", label: "département entier" },
            ].map(item => (
              <div class="bg-[#1E4B8C]/80 backdrop-blur-md border border-white/20 rounded-xl px-5 py-3 text-center shadow-xl min-w-[110px]">
                <p class="text-2xl font-extrabold text-white leading-none mb-1" style="font-family:'Montserrat',sans-serif;">{item.val}</p>
                <p class="text-blue-200 text-xs font-medium">{item.label}</p>
              </div>
            ))}
            <div class="bg-[#E8650A]/85 backdrop-blur-md border border-white/20 rounded-xl px-5 py-3 text-center shadow-xl min-w-[110px]">
              <p class="text-2xl font-extrabold text-white leading-none mb-1" style="font-family:'Montserrat',sans-serif;">RGE</p>
              <p class="text-orange-100 text-xs font-medium">Qualibat certifié</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       LES TYPES DE SINISTRES
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-[#F0F5FC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Diagnostic</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 leading-tight" style="font-family:'Montserrat',sans-serif;">
          Quels types de sinistres<br>nécessitent une remise en état ?
        </h2>
        <p class="text-gray-600 mt-4 text-lg leading-relaxed">
          Chaque sinistre est unique, mais tous nécessitent une intervention rapide et professionnelle pour éviter l'aggravation.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {signes.map(s => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-md hover:border-[#E8650A]/20 transition-all duration-200">
            <span class="inline-flex items-center gap-1 bg-[#E8650A]/10 text-[#E8650A] text-xs font-semibold px-2.5 py-1 rounded-full mb-4">
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
              Alerte
            </span>
            <h3 class="font-bold text-[#1E4B8C] text-base mb-2" style="font-family:'Montserrat',sans-serif;">{s.titre}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOS PRESTATIONS
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Nos savoir-faire</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 leading-tight" style="font-family:'Montserrat',sans-serif;">
          Réfection des murs, plafonds<br>et revêtements après sinistre
        </h2>
        <p class="text-gray-600 mt-4 text-lg leading-relaxed">
          Conesa intervient sur l'ensemble des travaux de remise en état intérieure, du gros œuvre aux finitions.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-px bg-gray-200 rounded-3xl overflow-hidden shadow-sm">
        {prestations.map((p, i) => (
          <div class={`p-8 lg:p-10 ${i % 2 === 0 ? 'bg-[#1E4B8C]' : 'bg-white'}`}>
            <h3 class={`font-bold text-xl mb-3 ${i % 2 === 0 ? 'text-white' : 'text-[#1E4B8C]'}`} style="font-family:'Montserrat',sans-serif;">{p.titre}</h3>
            <p class={`text-sm leading-relaxed ${i % 2 === 0 ? 'text-blue-200' : 'text-gray-600'}`}>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA INTERMÉDIAIRE -->
  <section class="bg-[#1E4B8C] py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div class="text-white">
          <p class="font-extrabold text-xl sm:text-2xl leading-snug" style="font-family:'Montserrat',sans-serif;">
            Votre logement a subi un sinistre ?
          </p>
          <p class="text-blue-200 text-base mt-2">
            Nos équipes se déplacent rapidement dans tout le Tarn pour évaluer les dommages et vous remettre un devis gratuit.
          </p>
        </div>
        <a href="#contact" class="shrink-0 inline-flex items-center gap-2 bg-[#E8650A] hover:bg-orange-700 text-white font-bold px-8 py-4 rounded-xl transition-all duration-200 hover:scale-105 shadow-lg whitespace-nowrap">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Demander un devis gratuit
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       LES AVANTAGES
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24 bg-[#F0F5FC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="text-[#E8650A] font-semibold text-sm uppercase tracking-widest">Bénéfices</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#1E4B8C] mt-3 leading-tight" style="font-family:'Montserrat',sans-serif;">
          Pourquoi choisir Conesa pour<br>vos travaux après sinistre ?
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-8 lg:gap-12">
        {avantages.map(a => (
          <div>
            <div class={`h-1 w-12 rounded-full mb-5 ${a.color === 'orange' ? 'bg-[#E8650A]' : 'bg-[#1E4B8C]'}`}></div>
            <h3 class="font-extrabold text-[#1E4B8C] text-xl mb-3" style="font-family:'Montserrat',sans-serif;">{a.titre}</h3>

<script>
  // Bouton "Voir plus" mobile FAQ
  const faqCol2    = document.getElementById('faq-col2') as HTMLElement | null;
  const faqMoreBtn  = document.getElementById('faq-more-btn') as HTMLButtonElement | null;
  const faqMoreIcon = document.getElementById('faq-more-icon') as HTMLElement | null;
  faqMoreBtn?.addEventListener('click', () => {
    const isOpen = faqMoreBtn.dataset.open === 'true';
    if (isOpen) {
      faqCol2?.classList.add('hidden');
      faqCol2?.classList.remove('flex');
      faqMoreBtn.dataset.open = 'false';
      faqMoreBtn.childNodes[0].textContent = 'Voir plus de questions';
      if (faqMoreIcon) faqMoreIcon.style.transform = '';
    } else {
      faqCol2?.classList.remove('hidden');
      faqCol2?.classList.add('flex', 'flex-col');
      faqMoreBtn.dataset.open = 'true';
      faqMoreBtn.childNodes[0].textContent = 'Voir moins de questions';
      if (faqMoreIcon) faqMoreIcon.style.transform = 'rotate(180deg)';
    }
  });

  // Accordéon FAQ
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const trigger  = item.querySelector<HTMLButtonElement>('.faq-trigger')!;
    const body     = item.querySelector<HTMLElement>('.faq-body')!;
    const icon     = item.querySelector<SVGElement>('.faq-icon')!;
    const iconWrap = item.querySelector<HTMLElement>('.faq-icon-wrap')!;

    trigger.addEventListener('click', () => {
      const isOpen = item.dataset.open === 'true';

      document.querySelectorAll<HTMLElement>('.faq-item').forEach(other => {
        other.dataset.open = 'false';
        const b  = other.querySelector<HTMLElement>('.faq-body')!;
        const ic = other.querySelector<SVGElement>('.faq-icon')!;
        const iw = other.querySelector<HTMLElement>('.faq-icon-wrap')!;
        b.style.maxHeight = '0';
        ic.style.transform = '';
        if (iw) { iw.style.color = '#6B6156'; iw.style.borderColor = '#E0D5C8'; }
      });

      if (!isOpen) {
        item.dataset.open = 'true';
        body.style.maxHeight = body.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
        if (iconWrap) { iconWrap.style.color = '#A8442A'; iconWrap.style.borderColor = '#A8442A'; }
      }
    });
  });

  // Hover bar color on expertise list
  document.querySelectorAll<HTMLElement>('[data-bar]').forEach(bar => {
    const link = bar.closest('a');
    if (!link) return;
    link.addEventListener('mouseenter', () => { bar.style.background = '#A8442A'; });
    link.addEventListener('mouseleave', () => { bar.style.background = '#E0D5C8'; });
  });
</script>

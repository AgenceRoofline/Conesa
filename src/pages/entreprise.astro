---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZonesIntervention from '../components/ZonesIntervention.astro';

const valeurs = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    titre: "La confiance",
    desc: "Transparence, écoute et accompagnement sont au cœur de chaque projet. Nous entretenons une relation directe et honnête avec chacun de nos clients.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
    titre: "La qualité",
    desc: "Nous sélectionnons des matériaux et des solutions adaptés pour garantir des réalisations durables et performantes qui traversent le temps.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    titre: "La proximité",
    desc: "Entreprise familiale et locale, nous privilégions une relation directe avec nos clients et un suivi rigoureux de chaque chantier dans le Tarn.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    titre: "L'engagement",
    desc: "Nous nous impliquons pleinement dans chaque projet pour apporter des réponses concrètes et un résultat à la hauteur de vos attentes.",
  },
];

const expertises = [
  { label: "Isolation Thermique Extérieure",   desc: "Réduisez vos factures énergétiques et améliorez le confort de votre logement toute l'année. Travaux éligibles MaPrimeRénov' et CEE grâce à notre certification RGE Qualibat.", href: "/isolation" },
  { label: "Ravalement de façade",             desc: "Nettoyage, traitement des fissures, application d'enduits et de revêtements protecteurs. Nous redonnons à votre façade son aspect d'origine tout en renforçant sa durabilité.", href: "/ravalement-facade" },
  { label: "Peinture intérieure & extérieure", desc: "Finitions soignées pour vos espaces intérieurs et extérieurs : peinture, enduits décoratifs, revêtements muraux. Un résultat propre et durable adapté à vos goûts.", href: "/peinture-interieure-exterieure" },
  { label: "Entretien de toiture",             desc: "Démoussage, nettoyage haute pression, traitement hydrofuge et antimousse. Nous préservons l'étanchéité et prolongeons la durée de vie de votre toiture.", href: "/nettoyage-toiture" },
  { label: "Revêtements de sols",              desc: "Pose de sols souples, PVC, moquettes et parquets stratifiés. Des solutions adaptées à chaque espace et chaque usage, du logement au local professionnel.", href: "/revetements-sols" },
  { label: "Travaux après sinistre",           desc: "Dégât des eaux, incendie ou catastrophe naturelle : nous assurons la remise en état rapide des surfaces endommagées et coordonnons les interventions avec votre assurance.", href: "/travaux-apres-sinistre" },
];

const realisations = [
  { src: "/images/Réalisations/Cathédrale Albi - Conesa.png",     alt: "Rénovation de façade à Albi",    label: "Rénovation façade",    lieu: "Albi (81)",    pos: "left bottom" },
  { src: "/images/Réalisations/Ravalement de façade.webp",        alt: "Ravalement de façade",           label: "Ravalement de façade", lieu: "Castres (81)" },
  { src: "/images/Réalisations/Isolation extérieur - Conesa.png", alt: "Isolation thermique extérieure", label: "Isolation extérieure",  lieu: "Albi (81)" },
  { src: "/images/Réalisations/Peinture intérieure - Conesa.png", alt: "Peinture intérieure",            label: "Peinture intérieure",  lieu: "Gaillac (81)" },
  { src: "/images/Réalisations/Rénovation façade.JPG",            alt: "Rénovation de façade",           label: "Rénovation façade",    lieu: "Lavaur (81)" },
];

const faqs = [
  {
    q: "Depuis quand existe l'entreprise Conesa ?",
    a: "L'entreprise Conesa a été créée en 1969. Depuis plus de 55 ans, elle accompagne les propriétaires du Tarn dans leurs projets de rénovation, d'isolation thermique extérieure et d'entretien de l'habitat. Plusieurs générations se sont succédé à sa direction, garantissant une continuité du savoir-faire et des valeurs familiales.",
  },
  {
    q: "Dans quelles villes intervenez-vous ?",
    a: "Nous intervenons dans l'ensemble du département du Tarn (81) : Albi, Gaillac, Castres, Graulhet, Carmaux, Lavaur, Réalmont, Mazamet, Saint-Sulpice et toutes leurs communes environnantes. Contactez-nous pour vérifier notre disponibilité dans votre secteur.",
  },
  {
    q: "Réalisez-vous uniquement des travaux d'isolation extérieure ?",
    a: "Non, l'isolation thermique extérieure est l'une de nos spécialités, mais notre domaine d'intervention est bien plus large. Nous réalisons également le ravalement et la rénovation de façades, les travaux de peinture intérieure et extérieure, l'entretien de toiture, la pose de revêtements de sols et les travaux de remise en état après sinistre.",
  },
  {
    q: "Êtes-vous certifiés RGE ?",
    a: "Oui, Conesa est certifiée RGE (Reconnu Garant de l'Environnement) et Qualibat. Ces certifications attestent de notre engagement en faveur de la qualité et de la performance énergétique. Elles vous permettent également de bénéficier des aides financières disponibles (MaPrimeRénov', CEE, éco-prêt à taux zéro) pour vos projets de rénovation énergétique.",
  },
  {
    q: "Comment obtenir un devis ?",
    a: "Remplissez notre formulaire en ligne, appelez-nous ou envoyez-nous un email. Nous vous répondons sous 24h pour organiser une visite gratuite sur site. À l'issue de cette visite, nous vous remettons un devis détaillé, gratuit et sans engagement.",
  },
  {
    q: "Accompagnez-vous les particuliers et les professionnels ?",
    a: "Oui, nous intervenons aussi bien pour des particuliers que pour des professionnels : copropriétés, commerces, bâtiments tertiaires. Nos équipes s'adaptent aux contraintes et aux exigences spécifiques de chaque type de chantier.",
  },
  {
    q: "Quels types de projets réalisez-vous ?",
    a: "Nous réalisons tous types de projets de rénovation : isolation thermique extérieure, ravalement de façade, peinture intérieure et extérieure, entretien de toiture, pose de revêtements de sols et travaux après sinistre. Nous pouvons intervenir sur un seul poste ou coordonner une rénovation globale de votre bien.",
  },
  {
    q: "Comment se déroule un chantier ?",
    a: "Après votre prise de contact, nous organisons une visite sur site pour étudier votre projet. Nous établissons ensuite un devis détaillé et un planning de chantier. Les travaux sont réalisés par nos équipes avec un suivi régulier. En fin de chantier, nous procédons à une réception des travaux pour nous assurer de votre entière satisfaction.",
  },
];
---

<BaseLayout
  title="Entreprise familiale de rénovation dans le Tarn"
  description="Entreprise familiale de rénovation dans le Tarn depuis 1969. Isolation extérieure, façade, peinture, toiture. Certifiée RGE et Qualibat. Devis gratuit."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="relative overflow-hidden pt-[150px] sm:pt-[210px] sm:pb-[120px] sm:min-h-[680px]" style="background:#2B2622;">
    <!-- Mobile -->
    <img
      src={encodeURI("/images/Entreprise/hero entreprise familiale conesa mobile.png")}
      alt="Équipe Conesa, entreprise familiale de rénovation dans le Tarn depuis 1969"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center sm:hidden"
      fetchpriority="high"
      onerror="this.style.display='none'"
    />
    <!-- Tablette & Desktop -->
    <img
      src="/images/Entreprise/hero entreprise familiale conesa.png"
      alt="Équipe Conesa, entreprise familiale de rénovation dans le Tarn depuis 1969"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-top hidden sm:block"
      fetchpriority="high"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0" style="background:linear-gradient(135deg, rgba(43,38,34,0.78) 0%, rgba(43,38,34,0.55) 55%, rgba(43,38,34,0.25) 100%);"></div>

    <!-- Tampon 1969 -->
    <div class="hidden sm:flex absolute bottom-8 right-10 w-24 h-24 rounded-full flex-col items-center justify-center text-center pointer-events-none" style="border:2px solid rgba(233,222,211,0.45); transform:rotate(-8deg);">
      <span class="font-bold" style="font-family:'Bitter',serif; font-size:8px; letter-spacing:0.14em; color:#E9DED3;">DEPUIS</span>
      <span class="font-extrabold leading-none text-white" style="font-family:'Bitter',serif; font-size:22px;">1969</span>
      <span class="font-bold" style="font-family:'Bitter',serif; font-size:7px; letter-spacing:0.1em; color:#E9DED3;">ALBI · TARN</span>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">

        <!-- Filet arc-en-ciel -->
        <div class="flex mb-7 rounded-sm overflow-hidden" style="width:138px; height:5px;">
          <div style="flex:1; background:#C4362C;"></div>
          <div style="flex:1; background:#D98A2B;"></div>
          <div style="flex:1; background:#D9B43A;"></div>
          <div style="flex:1; background:#4A8F52;"></div>
          <div style="flex:1; background:#2F6FA8;"></div>
          <div style="flex:1; background:#B02A5B;"></div>
        </div>

        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium mb-8" style="background:rgba(233,222,211,0.08); border:1px solid rgba(233,222,211,0.2); border-radius:2px; color:#E9DED3;">
          <span class="w-2 h-2 rounded-full" style="background:#A8442A;"></span>
          Entreprise familiale dans le Tarn depuis 1969
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3rem] font-extrabold text-white leading-[1.1] mb-6" style="font-family:'Bitter',serif;">
          Une entreprise familiale<br>au service de l'habitat
          <span style="color:#D98A2B;"> depuis plus de 55 ans</span>
        </h1>

        <p class="text-base sm:text-lg leading-relaxed mb-4 max-w-xl" style="color:#E4DCD3;">
          Depuis plusieurs générations, Conesa accompagne les particuliers et les professionnels dans leurs projets de rénovation, d'isolation et d'embellissement de l'habitat dans tout le Tarn.
        </p>
        <p class="text-sm sm:text-base leading-relaxed mb-10 max-w-xl" style="color:#C9BEB2;">
          Une réputation fondée sur la qualité, la confiance et la proximité avec des centaines de familles du département.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#realisations" class="inline-flex items-center justify-center gap-2 text-white font-bold px-8 py-4 transition-all duration-200 hover:opacity-85" style="background:#A8442A; border-radius:3px;">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Découvrir nos réalisations
          </a>
          <a href="#contact" class="inline-flex items-center justify-center gap-2 font-semibold px-8 py-4 transition-all duration-200 hover:bg-white/5" style="border:1.5px solid rgba(233,222,211,0.4); color:#E9DED3; border-radius:3px;">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Demander un devis gratuit
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       HISTOIRE — PHOTO ÉQUIPE
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24" style="background:#FAF6F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="font-semibold text-sm uppercase tracking-widest" style="color:#A8442A;">Notre histoire</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 mb-4 leading-tight" style="font-family:'Bitter',serif; color:#2B2622;">
            Une histoire de famille et de savoir-faire
          </h2>
          <div class="flex mb-8 rounded-sm overflow-hidden" style="width:80px; height:3px;">
            <div style="flex:1; background:#C4362C;"></div>
            <div style="flex:1; background:#D98A2B;"></div>
            <div style="flex:1; background:#4A8F52;"></div>
          </div>
          <div class="space-y-4 leading-relaxed text-sm sm:text-base" style="color:#4B4238;">
            <p>Depuis sa création en 1969, l'entreprise Conesa a su évoluer avec son époque tout en conservant les valeurs qui ont fait sa réputation : le sérieux, la proximité et le travail bien fait.</p>
            <p>Au fil des décennies, nous avons accompagné plusieurs générations de propriétaires dans la rénovation, l'entretien et la valorisation de leur patrimoine immobilier.</p>
            <p>Cette expérience nous permet aujourd'hui d'apporter des solutions adaptées aux enjeux actuels de la rénovation énergétique et de l'amélioration de l'habitat.</p>
          </div>

          <div class="grid grid-cols-3 gap-4 mt-10 pt-8" style="border-top:1px solid #E0D5C8;">
            {[
              { val: "1969", label: "Année de création" },
              { val: "3", label: "générations familiales" },
              { val: "81", label: "Tarn, notre territoire" },
            ].map(item => (
              <div class="text-center">
                <p class="text-2xl font-extrabold" style="font-family:'Bitter',serif; color:#2B2622;">{item.val}</p>
                <p class="text-xs mt-1 leading-snug" style="color:#6B6156;">{item.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Photo équipe / chantier -->
        <div class="relative">
          <div class="overflow-hidden aspect-[4/3]" style="border-radius:4px; background:#E9DED3;">
            <img
              src="/images/Entreprise/Camion conesa.png"
              alt="L'équipe Conesa sur chantier"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
          </div>
          <!-- Badge flottant -->
          <div class="absolute -bottom-5 -left-5 text-white p-5 shadow-xl" style="background:#2B2622; border-radius:4px;">
            <p class="text-3xl font-extrabold" style="font-family:'Bitter',serif;">55+</p>
            <p class="text-xs font-medium" style="color:#C9BEB2;">ans d'expertise</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOS VALEURS
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24" style="background:#FAF6F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="font-semibold text-sm uppercase tracking-widest" style="color:#A8442A;">Ce qui nous définit</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 leading-tight" style="font-family:'Bitter',serif; color:#2B2622;">
          Nos valeurs
        </h2>
        <div class="flex mx-auto mt-3 mb-4 rounded-sm overflow-hidden" style="width:80px; height:3px;">
          <div style="flex:1; background:#C4362C;"></div>
          <div style="flex:1; background:#D98A2B;"></div>
          <div style="flex:1; background:#4A8F52;"></div>
        </div>
        <p class="mt-4 text-base sm:text-lg max-w-2xl mx-auto" style="color:#4B4238;">
          Depuis 1969, ces principes guident chacune de nos interventions et notre relation avec nos clients.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {valeurs.map(v => (
          <div class="p-7 group hover:shadow-md transition-all duration-300" style="background:#fff; border:1px solid #E0D5C8; border-radius:4px;">
            <div class="w-14 h-14 bg-[#FAF6F0] group-hover:bg-[#A8442A] flex items-center justify-center text-[#A8442A] group-hover:text-white transition-colors duration-300 mb-5" style="border-radius:3px;">
              <Fragment set:html={v.icon} />
            </div>
            <h3 class="font-bold text-base mb-3" style="font-family:'Bitter',serif; color:#2B2622;">{v.titre}</h3>
            <p class="text-sm leading-relaxed" style="color:#6B6156;">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PHOTO CHANTIER + CERTIFICATIONS
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24" style="background:#FAF6F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Photo certif -->
        <div class="relative">
          <div class="overflow-hidden max-w-xs sm:max-w-sm lg:max-w-full mx-auto" style="border-radius:4px;">
            <img
              src="/images/Entreprise/Certification RGE Qualibat.png"
              alt="Certification RGE Qualibat Conesa"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
          </div>
        </div>

        <!-- Certifications -->
        <div>
          <span class="font-semibold text-sm uppercase tracking-widest" style="color:#A8442A;">Qualifications</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 mb-4 leading-tight" style="font-family:'Bitter',serif; color:#2B2622;">
            Des certifications reconnues dans le bâtiment
          </h2>
          <div class="flex mb-6 rounded-sm overflow-hidden" style="width:80px; height:3px;">
            <div style="flex:1; background:#C4362C;"></div>
            <div style="flex:1; background:#D98A2B;"></div>
            <div style="flex:1; background:#4A8F52;"></div>
          </div>
          <p class="text-sm sm:text-base leading-relaxed mb-8" style="color:#4B4238;">
            Afin de garantir des prestations conformes aux standards les plus exigeants, Conesa dispose de certifications reconnues dans le secteur du bâtiment et de la rénovation énergétique. Ces qualifications témoignent de notre engagement en faveur de la qualité et du respect des bonnes pratiques.
          </p>

          <div class="space-y-4 mb-8">
            {[
              { titre: "RGE — Reconnu Garant de l'Environnement", desc: "Vous permet d'accéder aux aides financières de l'État (MaPrimeRénov', CEE, éco-prêt à taux zéro)." },
              { titre: "Qualibat", desc: "Certification nationale qui atteste de la compétence, du sérieux et de la solidité financière de l'entreprise." },
              { titre: "Qualifications professionnelles du bâtiment", desc: "Reconnaissance de notre savoir-faire dans les métiers de la rénovation et de l'isolation." },
            ].map(c => (
              <div class="flex items-start gap-4 p-4 transition-all" style="border:1px solid #E0D5C8; border-radius:4px;">
                <span class="w-6 h-6 flex items-center justify-center shrink-0 mt-0.5" style="background:#A8442A; border-radius:50%;">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </span>
                <div>
                  <p class="font-semibold text-sm mb-1" style="font-family:'Bitter',serif; color:#2B2622;">{c.titre}</p>
                  <p class="text-sm leading-relaxed" style="color:#6B6156;">{c.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <a href="#contact" class="inline-flex items-center gap-2 text-white font-bold px-8 py-4 transition-all duration-200 hover:opacity-85" style="background:#A8442A; border-radius:3px;">
            Demander un devis gratuit
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NOS EXPERTISES
  ══════════════════════════════════════ -->
  <section class="py-8 lg:py-24" style="background:#FAF6F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="font-semibold text-sm uppercase tracking-widest" style="color:#A8442A;">Nos savoir-faire</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 leading-tight" style="font-family:'Bitter',serif; color:#2B2622;">
          Nos domaines d'expertise
        </h2>
        <div class="flex mx-auto mt-3 mb-4 rounded-sm overflow-hidden" style="width:80px; height:3px;">
          <div style="flex:1; background:#C4362C;"></div>
          <div style="flex:1; background:#D98A2B;"></div>

        <div class="mt-2 mb-5 h-0.5 w-8 rounded-full" style="background:#A8442A;"></div>
        <ul class="space-y-2.5">
          {services.map(s => (
            <li><a href={s.href} class="text-sm transition-opacity hover:opacity-100" style="color:#C9BEB2; opacity:0.85;">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Nos villes — masqué sur mobile -->
      <div class="hidden md:block">
        <p class="font-extrabold text-xs uppercase tracking-widest" style="font-family:'Bitter',serif; color:#FAF6F0; letter-spacing:0.12em;">Nos villes</p>
        <div class="mt-2 mb-5 h-0.5 w-8 rounded-full" style="background:#D98A2B;"></div>
        <ul class="space-y-2.5">
          {villes.map(v => (
            <li><a href={`/villes/${v.slug}`} class="text-sm transition-opacity hover:opacity-100" style="color:#C9BEB2; opacity:0.85;">{v.nom}</a></li>
          ))}

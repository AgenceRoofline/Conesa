    </div>
  </div>

  <!-- Ligne arc-en-ciel + bas de page -->
  <div>
    <div class="flex" style="height:3px;">
      {rainbowColors.map(c => (
        <div style={`flex:1; background:${c};`}></div>
      ))}
    </div>
    <div class="w-full px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center gap-2" style="border-top:1px solid rgba(233,222,211,0.08);">

        <div class="mt-2 mb-5 h-0.5 w-8 rounded-full" style="background:#2F6FA8;"></div>
        <ul class="space-y-2.5">
          {entrepriseLinks.map(l => (
            <li><a href={l.href} class="text-sm transition-opacity hover:opacity-100" style="color:#C9BEB2; opacity:0.85;">{l.label}</a></li>

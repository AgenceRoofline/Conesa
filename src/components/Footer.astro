---
const services = [
  { label: "Isolation Thermique Extérieure", href: "/isolation" },
  { label: "Ravalement de façade",           href: "/ravalement-facade" },
  { label: "Peinture intérieure & extérieure", href: "/peinture-interieure-exterieure" },
  { label: "Entretien de toiture",            href: "/nettoyage-toiture" },
  { label: "Revêtements de sols",             href: "/revetements-sols" },
  { label: "Travaux après sinistre",          href: "/travaux-apres-sinistre" },
];
const villes = [
  { nom: "Albi",     slug: "albi" },
  { nom: "Gaillac",  slug: "gaillac" },
  { nom: "Castres",  slug: "castres" },
  { nom: "Graulhet", slug: "graulhet" },
];
const entrepriseLinks = [
  { label: "Qui sommes-nous ?",   href: "/entreprise" },
  { label: "Nos réalisations",    href: "/#realisations" },
  { label: "Blog & conseils",     href: "/blog" },
  { label: "Demander un devis",   href: "#contact" },
];
const prestations = [
  "Isolation Thermique Extérieure (ITE)",
  "Ravalement de façade",
  "Peinture intérieure",
  "Peinture extérieure",
  "Entretien de toiture",
  "Revêtements de sols",
  "Travaux après sinistre",
  "Autre / Je ne sais pas encore",
];
const rainbowColors = ["#C4362C","#D98A2B","#D9B43A","#4A8F52","#2F6FA8","#B02A5B"];
---

<footer id="contact" style="background:#2B2622; color:#C9BEB2;">

  <!-- ══════════════════════════════════════
       FORMULAIRE DE CONTACT / DEVIS
  ══════════════════════════════════════ -->
  <div style="border-bottom:1px solid rgba(233,222,211,0.12);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid lg:grid-cols-2 gap-12 items-start">

        <!-- Infos gauche -->
        <div>
          <span class="font-bold text-sm uppercase tracking-widest" style="color:#A8442A;">Contactez-nous</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 mb-5 leading-tight" style="font-family:'Bitter',serif; color:#FAF6F0;">
            Demandez votre<br>devis gratuit
          </h2>
          <p class="text-base leading-relaxed mb-8" style="color:#C9BEB2;">
            Réponse garantie sous 24h. Déplacement et devis sans engagement.
          </p>
          <ul class="space-y-4 text-sm">
            <li class="flex items-center gap-3">
              <span class="w-9 h-9 flex items-center justify-center shrink-0" style="background:rgba(168,68,42,0.15); border-radius:2px;">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </span>
              <a href="tel:0563541697" class="transition-opacity hover:opacity-80" style="color:#FAF6F0; font-weight:600;">05 63 54 16 97</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-9 h-9 flex items-center justify-center shrink-0" style="background:rgba(168,68,42,0.15); border-radius:2px;">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
              <a href="mailto:conesa81@wanadoo.fr" class="transition-opacity hover:opacity-80" style="color:#C9BEB2;">conesa81@wanadoo.fr</a>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-9 h-9 flex items-center justify-center shrink-0" style="background:rgba(168,68,42,0.15); border-radius:2px;">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <span style="color:#C9BEB2;">31 Petit Chemin des Broucouniès, 81000 Albi</span>
            </li>
          </ul>
        </div>

        <!-- Formulaire sur fond papier -->
        <form
          id="conesa-contact-form"
          method="POST"
          action="/contact.php"
          class="flex flex-col gap-4"
          style="background:#FAF6F0; border-radius:4px; padding:28px 32px;"
          novalidate
        >
          <!-- Honeypot -->
          <div style="display:none;" aria-hidden="true">
            <input type="text" name="website" id="cf-website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="csrf_token" id="cf-csrf" value="" />
          <input type="hidden" name="page_source" id="cf-page-source" value="" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="cf-nom" class="text-xs font-bold uppercase tracking-wide" style="color:#6B6156;">Prénom / Nom *</label>
              <input
                id="cf-nom" type="text" name="nom" required placeholder="Jean Dupont"
                class="px-4 py-2.5 text-sm transition-colors focus:outline-none"
                style="background:#fff; border:1px solid #E0D5C8; border-radius:2px; color:#2B2622;"
              />
              <span id="cf-nom-error" class="cf-error hidden text-xs mt-0.5" style="color:#C4362C;"></span>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="cf-telephone" class="text-xs font-bold uppercase tracking-wide" style="color:#6B6156;">Téléphone *</label>
              <input
                id="cf-telephone" type="tel" name="telephone" required placeholder="06 XX XX XX XX"
                class="px-4 py-2.5 text-sm transition-colors focus:outline-none"
                style="background:#fff; border:1px solid #E0D5C8; border-radius:2px; color:#2B2622;"
              />
              <span id="cf-telephone-error" class="cf-error hidden text-xs mt-0.5" style="color:#C4362C;"></span>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="cf-email" class="text-xs font-bold uppercase tracking-wide" style="color:#6B6156;">Email *</label>
            <input
              id="cf-email" type="email" name="email" required placeholder="jean@email.fr"
              class="px-4 py-2.5 text-sm transition-colors focus:outline-none"
              style="background:#fff; border:1px solid #E0D5C8; border-radius:2px; color:#2B2622;"
            />
            <span id="cf-email-error" class="cf-error hidden text-xs mt-0.5" style="color:#C4362C;"></span>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="cf-ville" class="text-xs font-bold uppercase tracking-wide" style="color:#6B6156;">Ville / Code postal</label>
              <input
                id="cf-ville" type="text" name="ville" placeholder="Albi, 81000"
                class="px-4 py-2.5 text-sm transition-colors focus:outline-none"
                style="background:#fff; border:1px solid #E0D5C8; border-radius:2px; color:#2B2622;"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="cf-prestation" class="text-xs font-bold uppercase tracking-wide" style="color:#6B6156;">Type de prestation</label>
              <select
                id="cf-prestation" name="prestation"
                class="px-4 py-2.5 text-sm transition-colors focus:outline-none"
                style="background:#fff; border:1px solid #E0D5C8; border-radius:2px; color:#2B2622;"
              >
                <option value="" disabled selected>Choisir...</option>
                {prestations.map(p => <option value={p}>{p}</option>)}
              </select>
              <span id="cf-prestation-error" class="cf-error hidden text-xs mt-0.5" style="color:#C4362C;"></span>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="cf-message" class="text-xs font-bold uppercase tracking-wide" style="color:#6B6156;">Description du projet</label>
            <textarea
              id="cf-message" name="message" rows="3" placeholder="Décrivez brièvement votre projet..."
              class="px-4 py-2.5 text-sm transition-colors focus:outline-none resize-none"
              style="background:#fff; border:1px solid #E0D5C8; border-radius:2px; color:#2B2622;"
            ></textarea>
          </div>

          <div id="cf-global-error" class="hidden px-4 py-3 text-sm" style="background:rgba(196,54,44,0.1); border:1px solid rgba(196,54,44,0.3); border-radius:2px; color:#C4362C;"></div>

          <div id="cf-success" class="hidden px-5 py-4 flex items-start gap-3" style="background:rgba(74,143,82,0.12); border:1px solid rgba(74,143,82,0.3); border-radius:2px;">
            <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#4A8F52;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <p class="font-semibold text-sm" style="color:#4A8F52;">Demande envoyée avec succès !</p>
              <p class="text-xs mt-0.5" style="color:#6B6156;">Nous vous répondrons sous 24h. À très bientôt.</p>
            </div>
          </div>

          <button
            id="cf-submit"
            type="submit"
            class="w-full text-white font-bold py-3 flex items-center justify-center gap-2 mt-1 transition-opacity hover:opacity-85 disabled:opacity-60 disabled:cursor-not-allowed"
            style="background:#A8442A; border-radius:3px;"
          >
            <svg id="cf-submit-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <svg id="cf-submit-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
            <span id="cf-submit-label">Envoyer ma demande</span>
          </button>
          <p class="text-xs text-center" style="color:#6B6156;">Réponse sous 24h · Sans engagement</p>
        </form>

      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       CARTE GOOGLE MAPS (sans titre)
  ══════════════════════════════════════ -->
  <div class="w-full" style="height:280px;">
    <iframe
      src="https://www.google.com/maps?q=31+Petit+Chemin+des+Broucouni%C3%A8s%2C+81000+Albi&hl=fr&z=16&output=embed"
      width="100%"
      height="100%"
      style="border:0; display:block;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Localisation Conesa — 31 Petit Chemin des Broucouniès, 81000 Albi"
    ></iframe>
  </div>

  <!-- ══════════════════════════════════════
       COLONNES FOOTER — pleine largeur
  ══════════════════════════════════════ -->
  <div class="w-full px-6 lg:px-8 py-14" style="border-top:1px solid rgba(233,222,211,0.12);">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 max-w-none">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1 flex flex-col items-center text-center md:items-start md:text-left">
        <img

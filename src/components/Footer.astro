        </ul>
        <!-- Contact fusionné sous les liens -->
        <div class="mt-6 pt-5 space-y-2.5" style="border-top:1px solid rgba(233,222,211,0.12);">
          <a href="tel:0563541697" class="flex items-center gap-2 text-sm font-semibold transition-opacity hover:opacity-80" style="color:#FAF6F0;">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            05 63 54 16 97
          </a>
          <a href="mailto:conesa81@wanadoo.fr" class="flex items-center gap-2 text-sm transition-opacity hover:opacity-80" style="color:#C9BEB2;">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            conesa81@wanadoo.fr
          </a>
        </div>
      </div>

      <!-- Contact mobile uniquement -->
      <div class="col-span-2 md:hidden flex flex-col items-center text-center">
        <p class="font-extrabold text-xs uppercase tracking-widest" style="font-family:'Bitter',serif; color:#FAF6F0; letter-spacing:0.12em;">Contact</p>
        <div class="mt-2 mb-4 h-0.5 w-8 rounded-full" style="background:#4A8F52;"></div>
        <div class="space-y-2.5">
          <a href="tel:0563541697" class="flex items-center justify-center gap-2 text-sm font-semibold transition-opacity hover:opacity-80" style="color:#FAF6F0;">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            05 63 54 16 97
          </a>
          <a href="mailto:conesa81@wanadoo.fr" class="flex items-center justify-center gap-2 text-sm transition-opacity hover:opacity-80" style="color:#C9BEB2;">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#A8442A;">

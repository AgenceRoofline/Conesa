---
const currentPath = Astro.url.pathname;

const servicesNav = [
  { label: "Isolation",       href: "/isolation" },
  { label: "Façade",          href: "/ravalement-facade" },
  { label: "Peinture",        href: "/peinture-interieure-exterieure" },
  { label: "Toiture",         href: "/nettoyage-toiture" },
  { label: "Sols",            href: "/revetements-sols" },
  { label: "Après sinistre",  href: "/travaux-apres-sinistre" },
];

const villes = [
  { nom: "Albi",     slug: "albi",     color: "#C4362C" },
  { nom: "Gaillac",  slug: "gaillac",  color: "#D98A2B" },
  { nom: "Castres",  slug: "castres",  color: "#2F6FA8" },
  { nom: "Graulhet", slug: "graulhet", color: "#4A8F52" },
];

const rainbowColors = ["#C4362C","#D98A2B","#D9B43A","#4A8F52","#2F6FA8","#B02A5B"];
---

<!-- ═══════════════════════════════════
     HEADER CONTAINER (fixe, glisse au scroll)
═══════════════════════════════════ -->
<div id="headercontainer" class="fixed top-0 left-0 right-0 z-50" style="transition: transform 0.6s ease-in-out;">

<!-- ─── Pré-header ─── -->
<div id="preheader" style="background:#2B2622;">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-4">

    <div class="flex items-center gap-3 sm:gap-4">
      <a href="tel:0563541697" class="flex items-center gap-1.5 text-xs transition-opacity hover:opacity-80" style="color:#C9BEB2;">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        05 63 54 16 97
      </a>
      <span style="color:#4B4238;">|</span>
      <a href="mailto:conesa81@wanadoo.fr" class="flex items-center gap-1.5 text-xs transition-opacity hover:opacity-80" style="color:#C9BEB2;">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span class="hidden sm:inline">conesa81@wanadoo.fr</span>
        <span class="sm:hidden">Email</span>
      </a>
    </div>

    <div class="flex items-center gap-3 sm:gap-4">
      <div class="hidden lg:flex items-center gap-2">
        <img src="/images/labels/Logo-RGE.png" alt="RGE Qualibat" class="h-5 w-auto bg-white rounded p-0.5" loading="lazy" decoding="async" onerror="this.style.display='none'"/>
        <span class="text-xs" style="color:#C9BEB2;">Certifié RGE &amp; Qualibat</span>
      </div>
      <span class="hidden lg:block" style="color:#4B4238;">|</span>
      <a href="/#avis" class="hidden lg:flex items-center gap-1 transition-opacity hover:opacity-80">
        {[1,2,3,4,5].map(() => (
          <svg class="w-3 h-3 fill-yellow-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        ))}
        <span class="text-xs ml-1" style="color:#C9BEB2;">4,6/5 Google</span>
      </a>
      <span class="hidden lg:block" style="color:#4B4238;">|</span>
      <a href="/blog" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium transition-opacity hover:opacity-80" style="color:#C9BEB2;">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6m-6-4h2"/>
        </svg>
        Blog
      </a>
      <span class="hidden sm:block" style="color:#4B4238;">|</span>
      <a href="https://www.facebook.com/sarl.conesa/" target="_blank" rel="noopener noreferrer" aria-label="Facebook Conesa" class="transition-opacity hover:opacity-80" style="color:#C9BEB2;">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
      <span style="color:#4B4238;">|</span>
      <a href="#contact" class="inline-flex items-center gap-1.5 text-white font-semibold text-xs px-3 py-1.5 transition-opacity hover:opacity-85" style="background:#A8442A; border-radius:3px;">
        Devis gratuit
      </a>
    </div>

  </div>
</div>

<!-- ─── Header principal ─── -->
<header id="main-header" class="w-full" style="background:#FAF6F0; border-bottom:1px solid #E0D5C8; position:relative;">

  <!-- Rangée principale -->
  <div class="max-w-screen-2xl mx-auto flex items-center h-[70px] md:h-[90px] lg:h-[110px] px-6 lg:px-8 gap-4 lg:gap-6" style="position:relative;">

    <!-- Logo -->
    <a
      href="/"
      id="logo-anchor"
      class="flex items-center shrink-0"
      style="align-self: flex-start; position: relative; z-index: 20;"
    >
      <img
        id="logo-img"
        src={encodeURI("/images/Logo/logo-conesa (1).png")}
        alt="Conesa"
        class="w-auto block"
        style="height: 155px; transition: height 0.45s cubic-bezier(0.4,0,0.2,1);"
        onerror="this.style.display='none'"
      />
    </a>

    <!-- Nav services — centrée en absolu -->
    <nav class="hidden lg:flex items-center gap-0" style="position:absolute; left:50%; transform:translateX(-50%); white-space:nowrap;">
      {servicesNav.map(item => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
        return (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-semibold transition-all duration-150 border-b-2 whitespace-nowrap"
            style={isActive
              ? 'color:#1E4B8C; border-bottom-color:#1E4B8C;'
              : 'color:#2B2622; border-bottom-color:transparent;'}
            onmouseover={`this.style.color='#A8442A'; this.style.borderBottomColor='#A8442A';`}
            onmouseout={`this.style.color='${isActive ? '#1E4B8C' : '#2B2622'}'; this.style.borderBottomColor='${isActive ? '#1E4B8C' : 'transparent'}';`}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/entreprise"
        class="ml-5 px-3.5 py-1.5 text-sm font-semibold transition-all duration-150 whitespace-nowrap"
        style={currentPath === '/entreprise'
          ? 'border:1.5px solid #A8442A; border-radius:3px; color:#A8442A;'
          : 'border:1.5px solid #2B2622; border-radius:3px; color:#2B2622;'}
      >
        Qui sommes-nous ?
      </a>
    </nav>

    <!-- Droite : Nos villes (desktop) + burger (mobile) -->
    <div class="flex items-center gap-2 ml-auto shrink-0">

      <!-- Bouton Nos villes -->
      <button
        id="villes-btn"
        aria-label="Voir nos zones d'intervention"
        class="hidden lg:flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold transition-all duration-150"
        style="border:1.5px solid #E0D5C8; border-radius:3px; color:#4B4238; background:transparent;"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Nos villes
        <svg id="villes-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <!-- Burger mobile -->
      <button
        id="menu-toggle"
        aria-label="Menu"
        class="lg:hidden flex items-center justify-center w-10 h-10 transition-all duration-150"
        style="border:1.5px solid #E0D5C8; border-radius:3px; color:#4B4238;"
      >
        <svg id="icon-menu" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- ─── Panel villes — pleine largeur, sous le header, au survol ─── -->
  <div
    id="villes-panel"
    class="vp-hidden"
    style="position:absolute; top:100%; left:0; right:0; background:#FAF6F0; border-top:1px solid #E0D5C8; z-index:30;"
  >
    <div class="max-w-screen-2xl mx-auto px-8 py-3 flex items-center gap-5">
      <span class="text-xs font-bold uppercase tracking-widest shrink-0" style="color:#6B6156; letter-spacing:0.1em;">Zones d'intervention</span>
      <div class="w-px h-4 shrink-0" style="background:#E0D5C8;"></div>
      <div class="flex items-center gap-2">
        {villes.map(v => (
          <a
            href={`/villes/${v.slug}`}
            class="text-sm font-semibold px-2.5 py-1.5 transition-opacity hover:opacity-75"
            style={`border-left:3px solid ${v.color}; background:#fff; color:#2B2622; border-radius:2px; box-shadow:0 1px 3px rgba(43,38,34,0.07);`}
          >
            {v.nom}
          </a>
        ))}
      </div>
    </div>
    <!-- Ligne arc-en-ciel : visible seulement quand le panel est ouvert -->
    <div class="flex" style="height:4px;">
      {rainbowColors.map(c => (
        <div style={`flex:1; background:${c};`}></div>
      ))}
    </div>
  </div>

  <!-- ─── Menu nav mobile ─── -->
  <div id="mobile-menu" class="hidden lg:hidden" style="border-top:1px solid #E0D5C8; background:#FAF6F0;">
    <nav class="flex flex-col px-4 py-4 gap-0.5">
      {servicesNav.map(item => (
        <a href={item.href} class="py-2.5 px-3 text-sm font-semibold" style="color:#2B2622;">
          {item.label}
        </a>
      ))}
      <a href="/entreprise" class="py-2.5 px-3 text-sm font-semibold" style="color:#2B2622;">
        Qui sommes-nous ?
      </a>
      <div class="mt-3 pt-3" style="border-top:1px solid #E0D5C8;">
        <p class="text-xs font-bold uppercase tracking-widest px-3 mb-2" style="color:#6B6156;">Zones d'intervention</p>
        <div class="flex flex-wrap gap-2 px-3">
          {villes.map(v => (
            <a
              href={`/villes/${v.slug}`}
              class="text-xs font-semibold px-2.5 py-1.5"
              style={`border-left:3px solid ${v.color}; background:#fff; color:#2B2622; border-radius:2px;`}
            >
              {v.nom}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>

</header>

</div><!-- /#headercontainer -->

<style>
  @media (max-width: 1023px) {
    #logo-anchor { align-self: center !important; }
    #logo-img { height: 60px !important; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    #logo-img { height: 80px !important; }
  }

  /* Panel villes : masqué par défaut, animation fade */
  .vp-hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, visibility 0.18s ease;
  }
  .vp-visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.18s ease, visibility 0.18s ease;
  }
</style>

<script>
  // ── Burger mobile ──
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu   = document.getElementById('icon-menu');
  const iconClose  = document.getElementById('icon-close');

  menuToggle?.addEventListener('click', () => {
    const hidden = mobileMenu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden', !hidden);
    iconClose?.classList.toggle('hidden', !!hidden);
  });

  document.addEventListener('click', (e) => {
    const hc = document.getElementById('headercontainer');
    if (hc && !hc.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });

  // ── Panel villes : survol bouton → affiche la barre pleine largeur ──
  const villesBtn     = document.getElementById('villes-btn') as HTMLElement | null;
  const villesPanel   = document.getElementById('villes-panel') as HTMLElement | null;
  const villesChevron = document.getElementById('villes-chevron') as HTMLElement | null;
  let vpTimeout: ReturnType<typeof setTimeout>;

  function vpShow() {
    clearTimeout(vpTimeout);
    villesPanel?.classList.remove('vp-hidden');
    villesPanel?.classList.add('vp-visible');
    villesChevron?.classList.add('rotate-180');
  }

  function vpHide() {
    vpTimeout = setTimeout(() => {
      villesPanel?.classList.add('vp-hidden');
      villesPanel?.classList.remove('vp-visible');
      villesChevron?.classList.remove('rotate-180');
    }, 120);
  }

  villesBtn?.addEventListener('mouseenter', vpShow);
  villesBtn?.addEventListener('mouseleave', vpHide);
  villesPanel?.addEventListener('mouseenter', vpShow);
  villesPanel?.addEventListener('mouseleave', vpHide);

  // ── Logo hero : déborde en haut de page, se rétracte au scroll ──
  const logoAnchor = document.getElementById('logo-anchor') as HTMLElement | null;
  const logoImg    = document.getElementById('logo-img') as HTMLImageElement | null;

  function setLogoScrolled(scrolled: boolean) {
    if (!logoAnchor || !logoImg) return;
    if (window.innerWidth < 1024) return;
    if (scrolled) {
      logoImg.style.height       = '100px';
      logoAnchor.style.alignSelf = 'center';
    } else {
      logoImg.style.height       = '155px';
      logoAnchor.style.alignSelf = 'flex-start';
    }
  }

  setLogoScrolled(window.scrollY > 10);

  const headercontainer = document.getElementById('headercontainer') as HTMLElement | null;
  const preheader = document.getElementById('preheader') as HTMLElement | null;

  if (headercontainer && preheader) {
    let lastScrollTop = 0;
    window.addEventListener('scroll', function () {
      const currentScroll = window.scrollY;
      const preheaderH = preheader.offsetHeight;
      if (currentScroll > lastScrollTop) {
        headercontainer.style.transform = `translateY(-${preheaderH}px)`;
      } else if (currentScroll === 0) {
        headercontainer.style.transform = 'translateY(0)';
      }
      setLogoScrolled(currentScroll > 10);
      lastScrollTop = currentScroll <= 0 ? 0 : currentScroll;
    }, { passive: true });
  }

  window.addEventListener('resize', () => setLogoScrolled(window.scrollY > 10), { passive: true });
</script>

---
const zoneColors = ["#C4362C", "#D98A2B", "#4A8F52", "#2F6FA8"];
const zones = [
  { num: "01", nom: "Albi", zone: "& l'agglomération albigeoise", slug: "albi" },
  { num: "02", nom: "Gaillac", zone: "& le vignoble gaillacois", slug: "gaillac" },
  { num: "03", nom: "Castres", zone: "& l'agglomération castraise", slug: "castres" },
  { num: "04", nom: "Graulhet", zone: "& le secteur graulhétois", slug: "graulhet" },
];
---

<section class="py-8 lg:py-24" style="background:#2B2622;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="font-semibold text-sm uppercase tracking-widest" style="color:#D98A2B;">Proximité locale</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 leading-tight" style="font-family:'Bitter',serif; color:#FAF6F0;">
        Nous intervenons dans tout le Tarn
      </h2>
      <div class="flex mx-auto mt-3 mb-4 rounded-sm overflow-hidden" style="width:108px; height:4px;">
        <div style="flex:1; background:#C4362C;"></div>
        <div style="flex:1; background:#D98A2B;"></div>
        <div style="flex:1; background:#4A8F52;"></div>
        <div style="flex:1; background:#2F6FA8;"></div>
      </div>
      <p class="mt-4 text-lg leading-relaxed" style="color:#C9BEB2;">
        Une présence renforcée à <strong style="color:#FAF6F0;">Albi</strong>, <strong style="color:#FAF6F0;">Gaillac</strong>, <strong style="color:#FAF6F0;">Castres</strong> et <strong style="color:#FAF6F0;">Graulhet</strong>, pour tous vos travaux de rénovation et d'isolation dans le département du Tarn (81).
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-20 items-start mb-12">

      <!-- Texte -->
      <div>
        <p class="text-base leading-relaxed mb-5" style="color:#C9BEB2;">
          Entreprise familiale implantée dans le Tarn depuis 1969, Conesa accompagne les propriétaires dans leurs projets de
          <strong style="color:#FAF6F0;">rénovation de façade</strong>, d'<strong style="color:#FAF6F0;">isolation thermique extérieure</strong>,
          de <strong style="color:#FAF6F0;">peinture</strong> et d'<strong style="color:#FAF6F0;">entretien de toiture</strong>.
        </p>
        <p class="text-base leading-relaxed mb-8" style="color:#C9BEB2;">
          Que vous soyez dans l'Albigeois, le Gaillacois, le Castrais ou le Graulhétois, nos équipes se déplacent jusqu'à
          vous pour réaliser votre projet avec la même exigence et le même accompagnement personnalisé.
        </p>
        <a href="#contact" class="inline-flex items-center gap-2 text-white font-bold px-8 py-4 transition-all duration-200 hover:opacity-85" style="background:#A8442A; border-radius:3px;">
          Demander un devis gratuit
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Liste zones numérotées -->
      <div class="hidden lg:flex flex-col" style="border-top:1px solid rgba(233,222,211,0.12);">
        {zones.map((z, i) => (
          <a href={`/villes/${z.slug}`} class="group flex items-center gap-5 py-5 hover:pl-2 transition-all duration-200" style="border-bottom:1px solid rgba(233,222,211,0.12);">
            <span class="font-extrabold text-lg shrink-0 w-8" style={`font-family:'Bitter',serif; color:${zoneColors[i]};`}>{z.num}</span>
            <div class="flex-1 min-w-0">
              <span class="font-bold text-lg transition-colors duration-150" style="color:#FAF6F0;">{z.nom}</span>
              <span class="text-sm ml-2" style="color:#6B6156;">{z.zone}</span>
            </div>
            <svg class="w-4 h-4 shrink-0 transition-all duration-200" style={`color:${zoneColors[i]}; opacity:0.5;`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        ))}
      </div>

    </div>

  </div>
</section>
